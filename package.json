{
  "name": "@wpmoo/astro-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Moo UI Astro SDK, development apps and shared tooling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wpmoo-org/ui-astro.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/demo"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wpmoo/astro-demo --",
    "build": "npm run build --workspace @wpmoo/astro-demo --",
    "check": "npm run check --workspace @wpmoo/astro-demo --",
    "preview": "npm run preview --workspace @wpmoo/astro-demo --",
    "test": "node --test tests/*.test.mjs",
    "layout-contract:sync": "node scripts/sync_layout_contract.mjs --write --html-root ../html",
    "layout-contract:check": "node scripts/sync_layout_contract.mjs --check --html-root ../html",
    "pack:astro": "npm pack --workspace @wpmoo/astro"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.3",
    "typescript": "6.0.3"
  }
}
