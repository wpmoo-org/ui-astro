---
import { getSiteContext } from "@wpmoo/astro/context";
import Layout from "../../demo/Layout.astro";
import PageHeader from "../../includes/PageHeader.astro";
import Typography from "../../components/Typography.astro";
import Loop from "../../views/Loop.astro";
import PageLoop from "../../plugins/page/views/Loop.astro";
import { getDemoMessages } from "../../demo/messages.js";

const { site } = getSiteContext();
const lang = Astro.currentLocale ?? site.defaults.lang;
const copy = getDemoMessages(lang);
---

<Layout title={copy.emptyStateTitle} lang={lang} dir={site.defaults.dir} pageContext={{ view: "archive", type: "page" }}>
  <PageHeader title={copy.emptyStateTitle} />
  <Typography variant="section-title" content={copy.items} />
  <Loop items={[]} emptyText={copy.emptyItems} />
  <Typography variant="section-title" content={copy.pages} />
  <PageLoop entries={[]} lang={lang} emptyText={copy.emptyPages} />
</Layout>
