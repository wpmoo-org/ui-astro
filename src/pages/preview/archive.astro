---
import Layout from "../../layouts/Layout.astro";
import Header from "../../includes/Header.astro";
import Footer from "../../includes/Footer.astro";
import Archive from "../../views/Archive.astro";

const items = [
  { id: "duyuru.md", title: "A sample post", href: "/preview/single", description: "A reusable semantic Loop entry.", entryContext: { type: "post", id: "duyuru.md", source: "markdown", taxonomies: { category: ["kurumsal"] } } },
  { id: "guide.md", title: "Another post", href: "/preview/single", date: new Date("2026-09-28T12:00:00Z"), entryContext: { type: "post", id: "guide.md", source: "markdown" } },
];
---

<Layout title="Archive preview" pageContext={{ view: "archive", type: "post" }}>
  <Header slot="header" breadcrumbs={[{ label: "Home", href: "/" }, { label: "Archive" }]} />
  <Archive title="Posts" description="A common Archive view with a supplied Loop." items={items} />
  <Footer slot="footer" homeHref="/" brand="Moo UI" />
</Layout>
