---
import Layout from "../layouts/Layout.astro";
import Alert from "../components/Alert.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";
import ButtonGroup from "../components/ButtonGroup.astro";
import Card from "../components/Card.astro";
import Chart from "../components/Chart.astro";
import DataTable from "../components/DataTable.astro";
import DatePicker from "../components/DatePicker.astro";
import DropdownMenu from "../components/DropdownMenu.astro";
import Field from "../components/Field.astro";
import Form from "../components/Form.astro";
import Input from "../components/Input.astro";
import Navigation from "../components/Navigation.astro";
import Progress from "../components/Progress.astro";
import Select from "../components/Select.astro";
import Sidebar from "../components/Sidebar.astro";
import Typography from "../components/Typography.astro";

const sidebarGroups = [{
  label: "Workspace",
  items: [
    { title: "Overview", href: "/", icon: "panel-left", active: true },
    { title: "Components", href: "#components", icon: "layout-grid" },
    { title: "About", href: "#about", icon: "circle-info" },
  ],
}];
---

<Layout
  title="Moo UI Astro"
  description="Astro theme foundation powered by Moo UI."
  sidebar
  theme="dark"
  headerWidth="fluid"
  sidebarKey="astro-home"
  sidebarId="astro-sidebar"
>
  <Sidebar slot="sidebar" id="astro-sidebar" brand="Moo UI Astro" groups={sidebarGroups} />

  <nav slot="header" class="d-flex align-items-center gap-2 w-100" aria-label="Demo controls">
    <Button element="a" href="#components" variant="ghost" size="sm" class="d-none d-sm-inline-flex">Components</Button>
    <div class="d-flex align-items-center gap-2 ms-auto">
      <Button variant="ghost" size="sm" data-theme-toggle ariaLabel="Switch to light mode">Light mode</Button>
      <Button variant="ghost" size="sm" data-direction-toggle ariaLabel="Switch to RTL">RTL</Button>
      <Button element="a" href="https://github.com/wpmoo-org/ui" variant="outline" size="sm" class="d-none d-md-inline-flex" target="_blank" rel="noopener noreferrer" ariaLabel="Open Moo UI on GitHub">GitHub</Button>
    </div>
  </nav>

  <div class="py-5">
    <Badge label="Astro foundation" variant="outline" pill />
    <Typography
      variant="page-title"
      content="Build a theme on Moo UI contracts."
      class="display-5 mt-3"
    />
    <Typography
      variant="page-description"
      content="Astro owns page composition and theme layout. Moo UI supplies the Bootstrap-native component language."
      class="lead mt-3"
    />
    <ButtonGroup ariaLabel="Foundation actions" class="mt-4">
      <Button href="#components">Explore components</Button>
      <Button variant="outline" href="https://ui.wpmoo.org/"
        >Read the catalog</Button
      >
    </ButtonGroup>

    <section class="row g-3 mt-4" data-layout="page-grid" aria-label="Available-width layout example">
      <div class="col-12" data-page-col-lg="3">
        <div data-page-hide-from="lg">Compact navigation</div>
        <div data-page-show-from="lg">Wide navigation</div>
      </div>
      <div class="col-12" data-page-col-lg="9">
        <p class="mb-0">These columns respond to the Page rail, even when the Sidebar changes its width.</p>
      </div>
    </section>

    <Card
      id="components"
      title="Theme-ready primitives"
      subtitle="Compose with public Astro components."
      class="mt-5"
    >
      <Badge label="Ready" variant="success" pill />
      <Progress
        value={68}
        ariaLabel="Theme migration progress"
        showLabel
        class="mt-3"
      />
      <Alert
        title="Bootstrap owns native behavior"
        description="This foundation loads Bootstrap's bundle for its interactive examples; consuming themes should load only the plugins they use."
        variant="info"
        class="mt-3"
      />
    </Card>

    <Card
      title="Form composition"
      subtitle="Native controls remain server-renderable."
      class="mt-4"
    >
      <Form>
        <Field>
          <Input label="Theme name" id="theme-name" name="theme" value="Moo" />
        </Field>
        <Field class="mt-3">
          <Select
            label="Release channel"
            id="release-channel"
            name="channel"
            options={[
              { value: "stable", label: "Stable" },
              { value: "preview", label: "Preview" },
            ]}
          />
        </Field>
        <DatePicker
          id="publish-date"
          name="publish_date"
          ariaLabel="Publish date"
          class="mt-3"
        />
        <Button type="submit" class="mt-3">Save theme</Button>
      </Form>
    </Card>

    <Card
      title="Navigation and data"
      subtitle="Interactive ownership stays explicit."
      class="mt-4"
    >
      <Navigation
        ariaLabel="Theme views"
        items={[
          { label: "Overview", href: "/", active: true },
          { label: "Activity", href: "#activity" },
        ]}
      />
      <DropdownMenu
        label="More actions"
        items={[{ label: "Duplicate" }, { label: "Archive", destructive: true }]}
        class="mt-3"
      />
      <Chart
        id="theme-activity"
        ariaLabel="Theme activity"
        data={{ labels: ["A", "B"], datasets: [{ data: [1, 2] }] }}
        class="mt-4"
      />
      <DataTable
        id="theme-table"
        columns={[
          { key: "name", label: "Name" },
          { key: "status", label: "Status" },
        ]}
        rows={[{ id: "theme-row", cells: { name: "Moo", status: "Ready" } }]}
        class="mt-4"
      />
    </Card>
  </div>
</Layout>

<script>
  import { Datepicker, Chart, DataTable } from "../runtime/moo-ui.js";

  document.querySelectorAll("[data-datepicker]").forEach((root) => {
    Datepicker.getOrCreateInstance(root);
  });
  document.querySelectorAll(".chart").forEach((root) => {
    Chart.getOrCreateInstance(root);
  });
  document.querySelectorAll(".datatable").forEach((root) => {
    DataTable.getOrCreateInstance(root);
  });

  const owner = document.querySelector("[data-moo-document-owner]");
  const themeToggle = document.querySelector("[data-theme-toggle]");
  const directionToggle = document.querySelector("[data-direction-toggle]");

  function updateHostControls() {
    const nextTheme = owner?.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
    const nextDirection = document.documentElement.dir === "rtl" ? "LTR" : "RTL";
    if (themeToggle) {
      themeToggle.textContent = `${nextTheme[0].toUpperCase()}${nextTheme.slice(1)} mode`;
      themeToggle.setAttribute("aria-label", `Switch to ${nextTheme} mode`);
    }
    if (directionToggle) {
      directionToggle.textContent = nextDirection;
      directionToggle.setAttribute("aria-label", `Switch to ${nextDirection}`);
    }
  }

  themeToggle?.addEventListener("click", () => {
    if (!owner) return;
    const nextTheme = owner.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
    owner.setAttribute("data-bs-theme", nextTheme);
    try { localStorage.setItem("moo:theme", nextTheme); } catch (_) { /* Storage can be unavailable. */ }
    updateHostControls();
  });

  directionToggle?.addEventListener("click", () => {
    const nextDirection = document.documentElement.dir === "rtl" ? "ltr" : "rtl";
    document.documentElement.dir = nextDirection;
    try { localStorage.setItem("moo:direction", nextDirection); } catch (_) { /* Storage can be unavailable. */ }
    updateHostControls();
  });

  updateHostControls();
</script>
