---
import "../styles.css";
import stateSource from "@wpmoo/ui/state.js?raw";
import Button from "../components/Button.astro";
import Icon from "../components/internal/Icon.astro";
import { getPageClasses, type PageClassContext } from "../config/index.js";

type ShellMode = "viewport" | "contained";
type Theme = "light" | "dark";
type Direction = "ltr" | "rtl";
type PageWidth = "base" | "sm" | "md" | "lg" | "xl" | "xxl" | "fluid";

interface Props {
  title: string;
  description?: string;
  sidebar?: boolean;
  shellMode?: ShellMode;
  theme?: Theme;
  lang?: string;
  dir?: Direction;
  sidebarKey?: string;
  defaultOpen?: boolean;
  sidebarId?: string;
  ariaLabel?: string;
  id?: string;
  pageWidth?: PageWidth;
  headerWidth?: PageWidth | null;
  pageContext?: PageClassContext;
}

const containerClasses: Record<PageWidth, string> = {
  base: "container",
  sm: "container-sm",
  md: "container-md",
  lg: "container-lg",
  xl: "container-xl",
  xxl: "container-xxl",
  fluid: "container-fluid",
};
const identifierPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const shellModeValues: ShellMode[] = ["viewport", "contained"];
const themeValues: Theme[] = ["light", "dark"];
const directionValues: Direction[] = ["ltr", "rtl"];

const {
  title,
  description = "Moo UI components for Astro themes.",
  sidebar = false,
  shellMode = "viewport",
  theme = "light",
  lang = "en",
  dir = "ltr",
  sidebarKey = "",
  defaultOpen = true,
  sidebarId = "",
  ariaLabel = "Toggle sidebar",
  id = "",
  pageWidth = "xl",
  headerWidth = null,
  pageContext,
} = Astro.props;

if (typeof sidebar !== "boolean") {
  throw new TypeError("Layout sidebar must be boolean");
}
if (!shellModeValues.includes(shellMode)) {
  throw new TypeError(`Unknown Layout shell mode: ${String(shellMode)}`);
}
if (!themeValues.includes(theme)) {
  throw new TypeError(`Unknown Layout theme: ${String(theme)}`);
}
if (!directionValues.includes(dir)) {
  throw new TypeError(`Unknown Layout direction: ${String(dir)}`);
}
if (typeof lang !== "string" || !lang.trim()) {
  throw new TypeError("Invalid Layout language");
}
if (typeof defaultOpen !== "boolean") {
  throw new TypeError("Layout defaultOpen must be boolean");
}
if (typeof ariaLabel !== "string") {
  throw new TypeError("Layout trigger label must be a string");
}
if (headerWidth !== null && !Object.hasOwn(containerClasses, headerWidth)) {
  throw new TypeError(`Unknown Layout header width: ${String(headerWidth)}`);
}
if (!Object.hasOwn(containerClasses, pageWidth)) {
  throw new TypeError(`Unknown Layout page width: ${String(pageWidth)}`);
}
if (id && (id === "main-content" || !identifierPattern.test(id))) {
  throw new TypeError("Invalid Layout id");
}
if (sidebar) {
  if (!sidebarId || sidebarId === "main-content" || !identifierPattern.test(sidebarId)) {
    throw new TypeError("Invalid Layout sidebarId");
  }
  if (!sidebarKey || !identifierPattern.test(sidebarKey)) {
    throw new TypeError("Invalid Layout sidebarKey");
  }
  if (id && id === sidebarId) {
    throw new TypeError("Layout id and sidebarId must differ");
  }
}

const hasSidebarSlot = Astro.slots.has("sidebar");
if (sidebar && !hasSidebarSlot) {
  throw new TypeError("Layout sidebar requires a sidebar slot");
}
if (!sidebar && hasSidebarSlot) {
  throw new TypeError("Layout without sidebar does not accept a sidebar slot");
}
if (!Astro.slots.has("default")) {
  throw new TypeError("Layout requires default page content");
}

const resolvedHeaderWidth = headerWidth || pageWidth;
const hasHeader = sidebar || Astro.slots.has("header");
const pageClass = containerClasses[pageWidth];
const headerClass = containerClasses[resolvedHeaderWidth];
const pageClasses = getPageClasses(pageContext);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["moo-ui", pageClasses]} data-bs-theme={theme} data-moo-document-owner="true">
      <script is:inline set:html={stateSource}></script>
      <div class="wrapper" data-layout="app" data-shell-mode={shellMode} id={id || undefined} data-slot={sidebar ? "sidebar-wrapper" : undefined} data-sidebar-state={sidebar ? (defaultOpen ? "expanded" : "collapsed") : undefined} data-sidebar-key={sidebar ? sidebarKey : undefined}>
        {sidebar ? <script is:inline set:html={stateSource}></script> : null}
        {sidebar ? <slot name="sidebar" /> : null}
        <div data-slot="page">
          {hasHeader ? (
            <header class="bg-body border-bottom">
              <div class={headerClass}>
                <div class="d-flex align-items-center gap-2 py-2">
                  {sidebar ? (
                    <Button variant="ghost" size="icon-sm" class="sidebar-trigger" data-sidebar-trigger data-bs-target={`#${sidebarId}`} ariaLabel={ariaLabel} ariaControls={sidebarId} ariaExpanded={defaultOpen}>
                      <Icon name="panel-left" />
                    </Button>
                  ) : null}
                  <slot name="header" />
                </div>
              </div>
            </header>
          ) : null}
          <main id="main-content" tabindex="-1" class="scroll-fade-y no-scrollbar"><div class={pageClass} data-page-container><slot /></div></main>
          {Astro.slots.has("footer") ? <footer><div class={pageClass}><slot name="footer" /></div></footer> : null}
        </div>
      </div>
    </div>
    <script>
      import "../runtime/bootstrap.js";
      import { Sidebar } from "../runtime/moo-ui.js";

      document
        .querySelectorAll('[data-slot="sidebar-wrapper"]')
        .forEach((root) => Sidebar.getOrCreateInstance(root));
    </script>
  </body>
</html>
