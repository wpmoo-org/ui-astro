---
import "@wpmoo/ui/moo-ui.css";
import "../styles/layout.css";
import Button from "../components/Button.astro";
import Icon from "../components/internal/Icon.astro";
import Kbd from "../components/Kbd.astro";

type Navigation = "sidebar" | "none";
type ShellMode = "viewport" | "contained";
type Theme = "light" | "dark";
type PageWidth = "base" | "sm" | "md" | "lg" | "xl" | "xxl" | "fluid";

interface Props {
  title: string;
  description?: string;
  navigation: Navigation;
  shellMode?: ShellMode;
  theme?: Theme;
  sidebarKey?: string;
  defaultOpen?: boolean;
  sidebarId?: string;
  ariaLabel?: string;
  id?: string;
  pageWidth?: PageWidth;
  headerWidth?: PageWidth | null;
}

const containerClasses: Record<PageWidth, string> = {
  base: "container",
  sm: "container-sm",
  md: "container-md",
  lg: "container-lg",
  xl: "container-xl",
  xxl: "container-xxl",
  fluid: "container-fluid",
};
const identifierPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const navigationValues: Navigation[] = ["sidebar", "none"];
const shellModeValues: ShellMode[] = ["viewport", "contained"];
const themeValues: Theme[] = ["light", "dark"];

const {
  title,
  description = "Moo UI components for Astro themes.",
  navigation,
  shellMode = "viewport",
  theme = "light",
  sidebarKey = "",
  defaultOpen = true,
  sidebarId = "",
  ariaLabel = "Toggle sidebar",
  id = "",
  pageWidth = "xl",
  headerWidth = "fluid",
} = Astro.props;

if (!navigationValues.includes(navigation)) {
  throw new TypeError(`Unknown Layout navigation: ${String(navigation)}`);
}
if (!shellModeValues.includes(shellMode)) {
  throw new TypeError(`Unknown Layout shell mode: ${String(shellMode)}`);
}
if (!themeValues.includes(theme)) {
  throw new TypeError(`Unknown Layout theme: ${String(theme)}`);
}
if (typeof defaultOpen !== "boolean") {
  throw new TypeError("Layout defaultOpen must be boolean");
}
if (typeof ariaLabel !== "string") {
  throw new TypeError("Layout trigger label must be a string");
}
if (headerWidth !== null && !Object.hasOwn(containerClasses, headerWidth)) {
  throw new TypeError(`Unknown Layout header width: ${String(headerWidth)}`);
}
if (!Object.hasOwn(containerClasses, pageWidth)) {
  throw new TypeError(`Unknown Layout page width: ${String(pageWidth)}`);
}
if (id && (id === "main-content" || !identifierPattern.test(id))) {
  throw new TypeError("Invalid Layout id");
}
if (navigation === "sidebar") {
  if (!sidebarId || sidebarId === "main-content" || !identifierPattern.test(sidebarId)) {
    throw new TypeError("Invalid Layout sidebarId");
  }
  if (!sidebarKey || !identifierPattern.test(sidebarKey)) {
    throw new TypeError("Invalid Layout sidebarKey");
  }
  if (id && id === sidebarId) {
    throw new TypeError("Layout id and sidebarId must differ");
  }
}

const hasSidebarSlot = Astro.slots.has("sidebar");
if (navigation === "sidebar" && !hasSidebarSlot) {
  throw new TypeError('Layout navigation="sidebar" requires a sidebar slot');
}
if (navigation === "none" && hasSidebarSlot) {
  throw new TypeError('Layout navigation="none" does not accept a sidebar slot');
}
if (!Astro.slots.has("default")) {
  throw new TypeError("Layout requires default page content");
}

const resolvedHeaderWidth = headerWidth || pageWidth;
const hasHeader = navigation === "sidebar" || Astro.slots.has("header");
const pageClass = containerClasses[pageWidth];
const headerClass = containerClasses[resolvedHeaderWidth];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body>
    <div class="moo-ui" data-bs-theme={theme} data-moo-document-owner="true">
      <div class="wrapper" data-layout="app" data-shell-mode={shellMode} id={id || undefined} data-slot={navigation === "sidebar" ? "sidebar-wrapper" : undefined} data-sidebar-state={navigation === "sidebar" ? (defaultOpen ? "expanded" : "collapsed") : undefined} data-sidebar-key={navigation === "sidebar" ? sidebarKey : undefined}>
        {navigation === "sidebar" ? <slot name="sidebar" /> : null}
        <div data-slot="page">
          {hasHeader ? (
            <header>
              <div class={headerClass}>
                <nav class="navbar astro-layout__navbar d-flex align-items-center gap-2" aria-label="Layout controls">
                  <div class="d-flex align-items-center gap-3 flex-grow-1">
                    {navigation === "sidebar" ? (
                      <Button variant="ghost" class="btn-icon-sm sidebar-trigger astro-layout__sidebar-toggle" data-sidebar-trigger data-bs-target={`#${sidebarId}`} ariaLabel={ariaLabel} ariaControls={sidebarId} ariaExpanded={defaultOpen}>
                        <Icon name="panel-left" />
                      </Button>
                    ) : null}
                    <Button variant="ghost" class="astro-layout__search-trigger search-trigger" data-search-trigger ariaLabel="Search documentation">
                      <span class="search-trigger__label d-inline-flex align-items-center gap-2">
                        <Icon name="search" />
                        <span>Search</span>
                      </span>
                      <span class="search-trigger__shortcut"><Kbd text="⌘" /><Kbd text="K" /></span>
                    </Button>
                    <slot name="header" />
                  </div>
                  <div class="d-flex align-items-center gap-3 flex-shrink-0 ms-auto">
                    <Button variant="ghost" class="btn-icon astro-layout__theme-toggle" data-theme-toggle ariaLabel={theme === "dark" ? "Switch to light mode" : "Switch to dark mode"}>
                      <span class="astro-layout__theme-icon" data-theme-icon="light"><Icon name="sun" /></span>
                      <span class="astro-layout__theme-icon" data-theme-icon="dark"><Icon name="moon-star" /></span>
                    </Button>
                    <Button element="a" href="https://github.com/wpmoo-org/ui" variant="default" class="astro-layout__github-link" target="_blank" rel="noopener noreferrer" ariaLabel="Open Moo UI on GitHub">
                      <Icon name="github" />
                      <span class="astro-layout__github-label d-none d-lg-inline">wpmoo-org/ui</span>
                    </Button>
                  </div>
                </nav>
              </div>
            </header>
          ) : null}
          <main id="main-content" tabindex="-1" class="scroll-fade-y no-scrollbar"><div class={pageClass} data-page-container><slot /></div></main>
          {Astro.slots.has("footer") ? <footer><div class={pageClass}><slot name="footer" /></div></footer> : null}
        </div>
      </div>
    </div>
    <script>
      import "bootstrap/dist/js/bootstrap.bundle.min.js";
      import SidebarRuntime from "@wpmoo/ui/sidebar.js";

      document
        .querySelectorAll('[data-slot="sidebar-wrapper"]')
        .forEach((root) => SidebarRuntime.getOrCreateInstance(root));

      const themeOwner = document.querySelector("[data-moo-document-owner]");
      const themeToggle = document.querySelector("[data-theme-toggle]");

      themeToggle?.addEventListener("click", () => {
        if (!themeOwner) return;
        const nextTheme = themeOwner.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
        themeOwner.setAttribute("data-bs-theme", nextTheme);
        themeToggle.setAttribute("aria-label", nextTheme === "dark" ? "Switch to light mode" : "Switch to dark mode");
      });
    </script>
  </body>
</html>
