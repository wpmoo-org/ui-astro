---
import { render } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import {
  getLanguageLinks,
  getLocaleHref,
  getRouteLocale,
} from "../../../i18n/index.js";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../includes/Header.astro";
import Footer from "../../../includes/Footer.astro";
import Sidebar from "../../../includes/Sidebar.astro";
import { resolvePageOptions } from "../../../config/index.js";
import { resolveSeoMetadata } from "../../../seo/index.js";
import {
  getEntryHref,
  getSiteContext,
  getSiteNavigation,
} from "../../../context/index.js";
import { getPagePaths } from "../queries.js";
import { entryClassContext } from "../../../taxonomies/paths.js";
import Single from "../views/Single.astro";

export const prerender = true;
export async function getStaticPaths({ routePattern }: GetStaticPathsOptions) {
  const { site, plugins, taxonomies, taxonomyBasePath, i18n } =
    getSiteContext();
  const locale = i18n ? getRouteLocale(routePattern) : undefined;
  const reservedPrefixes = plugins
    .filter((plugin) => plugin.id !== "page" && plugin.basePath !== "/")
    .map(
      (plugin) => plugin.locales?.[locale ?? ""]?.basePath ?? plugin.basePath,
    );
  if (taxonomies.some((taxonomy) => taxonomy.archive))
    reservedPrefixes.push(taxonomyBasePath);
  if (i18n) reservedPrefixes.push(...i18n.locales.map((value) => `/${value}`));
  return getPagePaths({
    lang: locale ?? site.defaults.lang,
    reservedPrefixes,
    locale,
  });
}

const { entry } = Astro.props;
const routeContext = getSiteContext();
const { site } = routeContext;
const locale = routeContext.i18n ? entry.data.locale : undefined;
const options = resolvePageOptions(
  site,
  "page",
  "single",
  entry.data.options,
  locale,
);
const href = getEntryHref("page", entry);
const navigation = await getSiteNavigation(href, locale);
const localeHome = getLocaleHref("/", locale ?? site.defaults.lang);
const homeHref =
  navigation.find((item) => item.href === localeHome)?.href ??
  navigation[0]?.href ??
  href;
const links = routeContext.i18n ? await getLanguageLinks("page", entry) : [];
const breadcrumbs =
  href === homeHref
    ? [{ label: entry.data.title }]
    : [{ label: site.brand, href: homeHref }, { label: entry.data.title }];
const layoutProps = {
  title: entry.data.title,
  description: entry.data.description,
  metadata: Astro.site
    ? resolveSeoMetadata(site, {
        title: entry.data.title,
        description: entry.data.description,
        status: entry.data.status,
        type: "page",
        view: href === localeHome ? "home" : "single",
        lang: options.lang,
        url: new URL(href, Astro.site).href,
        alternates: links.map((link) => ({
          locale: link.locale,
          url: new URL(link.href, Astro.site).href,
        })),
        created_at: entry.data.created_at,
        published_at: entry.data.published_at,
        updated_at: entry.data.updated_at,
      })
    : undefined,
  pageContext: {
    view: "single" as const,
    entry: entryClassContext({ id: "page", sourceKind: "markdown" }, entry),
  },
  shellMode: options.shellMode,
  pageWidth: options.pageWidth,
  headerWidth: options.headerWidth,
  theme: options.theme,
  lang: options.lang,
  dir: options.dir,
  parts: options.parts,
};
const { Content } = await render(entry);
---

{
  options.sidebar ? (
    <Layout
      {...layoutProps}
      sidebar
      sidebarId="moo-site-sidebar"
      sidebarKey="moo-site"
      defaultOpen={options.sidebar.defaultOpen}
    >
      <Sidebar
        slot="sidebar"
        id="moo-site-sidebar"
        brand={site.brand}
        brandHref={homeHref}
        groups={[
          {
            items: navigation.map((item) => ({
              title: item.label,
              href: item.href,
              active: item.active,
            })),
          },
        ]}
        side={options.sidebar.side}
        variant={options.sidebar.variant}
        collapsible={options.sidebar.collapsible}
        rail={options.sidebar.rail}
        parts={options.parts}
      />
      <Header parts={options.parts} slot="header" breadcrumbs={breadcrumbs} />
      <Single parts={options.parts} entry={entry}>
        <Content />
      </Single>
      <Footer
        parts={options.parts}
        slot="footer"
        brand={site.brand}
        homeHref={homeHref}
      />
    </Layout>
  ) : (
    <Layout {...layoutProps}>
      <Header parts={options.parts} slot="header" breadcrumbs={breadcrumbs} />
      <Single parts={options.parts} entry={entry}>
        <Content />
      </Single>
      <Footer
        parts={options.parts}
        slot="footer"
        brand={site.brand}
        homeHref={homeHref}
      />
    </Layout>
  )
}
