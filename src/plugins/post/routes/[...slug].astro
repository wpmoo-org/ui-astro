---
import { render } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import {
  getLanguageLinks,
  getLocaleHref,
  getRouteLocale,
} from "../../../i18n/index.js";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../includes/Header.astro";
import Footer from "../../../includes/Footer.astro";
import Sidebar from "../../../includes/Sidebar.astro";
import { resolvePageOptions } from "../../../config/index.js";
import { resolveSeoMetadata } from "../../../seo/index.js";
import {
  getEntryHref,
  getSiteContext,
  getSiteNavigation,
} from "../../../context/index.js";
import { getPostPaths } from "../queries.js";
import Single from "../views/Single.astro";
import { entryClassContext } from "../../../taxonomies/paths.js";

export const prerender = true;
export async function getStaticPaths({ routePattern }: GetStaticPathsOptions) {
  const { site, plugins, i18n } = getSiteContext();
  const locale = i18n ? getRouteLocale(routePattern) : undefined;
  const plugin = plugins.find((item) => item.id === "post");
  if (!plugin)
    throw new TypeError("Post route requires the active post plugin");
  return getPostPaths({
    lang: locale ?? site.defaults.lang,
    locale,
    basePath: plugin.locales?.[locale ?? ""]?.basePath ?? plugin.basePath,
  });
}

const { entry } = Astro.props;
const routeContext = getSiteContext();
const { site, plugins } = routeContext;
const plugin = plugins.find((item) => item.id === "post");
if (!plugin) throw new TypeError("Post route requires the active post plugin");
const locale = routeContext.i18n ? entry.data.locale : undefined;
const label = plugin.locales?.[locale ?? ""]?.label ?? plugin.label;
const archiveHref = getLocaleHref(
  plugin.locales?.[locale ?? ""]?.basePath ?? plugin.basePath,
  locale ?? site.defaults.lang,
);
const options = resolvePageOptions(
  site,
  "post",
  "single",
  entry.data.options,
  locale,
);
const href = getEntryHref("post", entry);
const navigation = await getSiteNavigation(href, locale);
const homeHref =
  navigation.find(
    (item) => item.href === getLocaleHref("/", locale ?? site.defaults.lang),
  )?.href ??
  navigation[0]?.href ??
  archiveHref;
const links = routeContext.i18n ? await getLanguageLinks("post", entry) : [];
const breadcrumbs = [
  { label: homeHref === archiveHref ? label : site.brand, href: homeHref },
  ...(homeHref === archiveHref ? [] : [{ label, href: archiveHref }]),
  { label: entry.data.title },
];
const layoutProps = {
  title: entry.data.title,
  description: entry.data.description,
  metadata: Astro.site
    ? resolveSeoMetadata(site, {
        title: entry.data.title,
        description: entry.data.description,
        status: entry.data.status,
        type: "post",
        view: "single",
        lang: options.lang,
        url: new URL(href, Astro.site).href,
        alternates: links.map((link) => ({
          locale: link.locale,
          url: new URL(link.href, Astro.site).href,
        })),
        created_at: entry.data.created_at,
        published_at: entry.data.published_at,
        updated_at: entry.data.updated_at,
      })
    : undefined,
  pageContext: {
    view: "single" as const,
    entry: entryClassContext({ id: "post", sourceKind: "markdown" }, entry),
  },
  shellMode: options.shellMode,
  pageWidth: options.pageWidth,
  headerWidth: options.headerWidth,
  theme: options.theme,
  lang: options.lang,
  dir: options.dir,
  parts: options.parts,
};
const { Content } = await render(entry);
---

{
  options.sidebar ? (
    <Layout
      {...layoutProps}
      sidebar
      sidebarId="moo-site-sidebar"
      sidebarKey="moo-site"
      defaultOpen={options.sidebar.defaultOpen}
    >
      <Sidebar
        slot="sidebar"
        id="moo-site-sidebar"
        brand={site.brand}
        brandHref={homeHref}
        groups={[
          {
            items: navigation.map((item) => ({
              title: item.label,
              href: item.href,
              active: item.active,
            })),
          },
        ]}
        side={options.sidebar.side}
        variant={options.sidebar.variant}
        collapsible={options.sidebar.collapsible}
        rail={options.sidebar.rail}
        parts={options.parts}
      />
      <Header parts={options.parts} slot="header" breadcrumbs={breadcrumbs} />
      <Single parts={options.parts} lang={options.lang} entry={entry}>
        <Content />
      </Single>
      <Footer
        parts={options.parts}
        slot="footer"
        brand={site.brand}
        homeHref={homeHref}
      />
    </Layout>
  ) : (
    <Layout {...layoutProps}>
      <Header parts={options.parts} slot="header" breadcrumbs={breadcrumbs} />
      <Single parts={options.parts} lang={options.lang} entry={entry}>
        <Content />
      </Single>
      <Footer
        parts={options.parts}
        slot="footer"
        brand={site.brand}
        homeHref={homeHref}
      />
    </Layout>
  )
}
