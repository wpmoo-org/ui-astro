---
import Single from "../../../views/Single.astro";
import type { CollectionEntry } from "astro:content";

interface Props { entry: CollectionEntry<"post"> }
const { entry } = Astro.props;
if (entry?.collection !== "post") throw new TypeError("Post Single entry must belong to collection post");
const date = entry.data.published_at;
if (date !== undefined && (!(date instanceof Date) || !Number.isFinite(date.getTime()))) {
  throw new TypeError("Post Single published_at must be a valid Date");
}
const hasMetadata = Astro.slots.has("metadata");
---

<Single title={entry.data.title} description={entry.data.description} entryContext={{ type: "post", id: entry.id, source: "markdown" }} forwardedSlots={{ pageHeader: Astro.slots.has("page-header"), metadata: hasMetadata || date !== undefined, actions: Astro.slots.has("actions"), afterContent: Astro.slots.has("after-content") }}>
  {Astro.slots.has("page-header") ? <slot name="page-header" slot="page-header" /> : null}
  {hasMetadata ? <slot name="metadata" slot="metadata" /> : date ? <time slot="metadata" datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time> : null}
  {Astro.slots.has("actions") ? <slot name="actions" slot="actions" /> : null}
  <slot />
  {Astro.slots.has("after-content") ? <slot name="after-content" slot="after-content" /> : null}
</Single>
