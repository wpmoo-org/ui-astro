---
import type { ComponentProps } from "astro/types";
import Layout from "@wpmoo/astro/Layout.astro";
import Header from "@wpmoo/astro/includes/Header.astro";
import Sidebar from "@wpmoo/astro/includes/Sidebar.astro";
import Footer from "@wpmoo/astro/includes/Footer.astro";
import Button from "@wpmoo/astro/components/Button.astro";
import { getSiteContext } from "@wpmoo/astro/context";
import type { PageOptions } from "@wpmoo/astro/config";
import { getDemoMessages } from "./messages.js";
import { getDemoNavigation } from "./navigation.js";
import { demoControls, getDemoOptions } from "./settings.js";

type Props = ComponentProps<typeof Layout> & {
  sidebarOptions?: PageOptions["sidebar"];
};
const { title, sidebar = false, sidebarOptions, ...options } = Astro.props;
const context = getSiteContext();
const pageContext = options.pageContext;
const type = pageContext?.view === "single" ? pageContext.entry.type : pageContext?.view === "archive" ? pageContext.type : "page";
const view = pageContext?.view === "archive" ? "archive" : "single";
const defaults = getDemoOptions(type, view, { parts: options.parts, lang: options.lang });
const { lang, parts } = defaults;
const selectedSidebar = sidebarOptions === undefined ? defaults.sidebar : sidebarOptions;
const copy = getDemoMessages(lang);
const groups = getDemoNavigation(Astro.url.pathname, lang);
const homeHref = context.base;
const breadcrumbs = [{ label: context.site.brand, href: homeHref }, { label: title }];
const { sidebar: _sidebar, ...layoutDefaults } = defaults;
const layoutProps = { ...layoutDefaults, ...options, title, lang, parts, skipText: options.skipText ?? parts.header.skipLabel };
const sidebarId = options.sidebarId ?? "demo-sidebar";
const sidebarKey = options.sidebarKey ?? "astro-demo";
---

{sidebar ? (
  <Layout {...layoutProps} sidebar sidebarId={sidebarId} sidebarKey={sidebarKey} defaultOpen={options.defaultOpen ?? selectedSidebar?.defaultOpen ?? true}>
    <Sidebar slot="sidebar" id={sidebarId} brand={context.site.brand} brandHref={homeHref} parts={parts} groups={groups} side={selectedSidebar?.side} variant={selectedSidebar?.variant} collapsible={selectedSidebar?.collapsible} rail={selectedSidebar?.rail} ariaLabel={copy.examples}>
      <span slot="footer" class:list={demoControls.sidebarFooterUtilities}>{context.site.brand}</span>
    </Sidebar>
    <Header slot="header" parts={parts} breadcrumbs={breadcrumbs} ariaLabel={parts.header.breadcrumbLabel}>
      <Button slot="actions" element="a" href={homeHref} {...demoControls.action}>{copy.overview}</Button>
    </Header>
    <slot />
    <Footer slot="footer" parts={parts} homeHref={homeHref} brand={context.site.brand} />
  </Layout>
) : (
  <Layout {...layoutProps}>
    <Header slot="header" parts={parts} breadcrumbs={breadcrumbs} ariaLabel={parts.header.breadcrumbLabel}>
      <Button slot="actions" element="a" href={homeHref} {...demoControls.action}>{copy.overview}</Button>
    </Header>
    <slot />
    <Footer slot="footer" parts={parts} homeHref={homeHref} brand={context.site.brand} />
  </Layout>
)}
