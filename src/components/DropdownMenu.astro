---
import Button from "./Button.astro";

interface Item { label: string; href?: string; active?: boolean; disabled?: boolean; destructive?: boolean; shortcut?: string; target?: string; rel?: string; }
interface Props {
  label: string;
  items?: Item[];
  variant?: "default" | "secondary" | "outline" | "ghost" | "destructive" | "link" | "success" | "warning" | "info" | "light" | "dark" | "outline-primary" | "outline-success" | "outline-danger";
  size?: "default" | "xs" | "sm" | "lg";
  align?: "" | "start" | "end";
  caret?: boolean;
  autoClose?: "" | "true" | "false" | "inside" | "outside";
  offset?: string;
  ariaLabel?: string;
  class?: string;
  [key: string]: unknown;
}

const { label, items = [], variant = "outline", size = "default", align = "", caret = false, autoClose = "", offset = "", ariaLabel = "", class: className = "", ...rest } = Astro.props;
---

<div {...rest} class:list={["dropdown", className]}>
  <Button label={label} variant={variant} size={size} ariaLabel={ariaLabel} dropdown dropdownCaret={caret} dropdownOffset={offset} dropdownAutoClose={autoClose} />
  <ul class:list={["dropdown-menu", align ? `dropdown-menu-${align}` : ""]}>
    {items.map((item) => <li>{item.href ? <a class:list={["dropdown-item", item.active ? "active" : "", item.disabled ? "disabled" : ""]} href={item.disabled ? undefined : item.href} target={item.target} rel={item.rel} aria-disabled={item.disabled ? "true" : undefined} tabindex={item.disabled ? -1 : undefined} aria-current={item.active ? "true" : undefined} data-variant={item.destructive ? "destructive" : undefined}><span>{item.label}</span>{item.shortcut ? <span class="ms-auto small text-body-secondary">{item.shortcut}</span> : null}</a> : <button class:list={["dropdown-item", item.active ? "active" : ""]} type="button" disabled={item.disabled} data-variant={item.destructive ? "destructive" : undefined}><span>{item.label}</span>{item.shortcut ? <span class="ms-auto small text-body-secondary">{item.shortcut}</span> : null}</button>}</li>)}
    <slot />
  </ul>
</div>
