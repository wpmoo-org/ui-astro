---
import CloseButton from "./CloseButton.astro";

interface Props {
  id: string;
  title?: string;
  placement?: "start" | "end" | "top" | "bottom";
  backdrop?: boolean;
  scroll?: boolean;
  ariaLabel?: string;
  class?: string;
  [key: string]: unknown;
}

const { id, title = "", placement = "end", backdrop = true, scroll = false, ariaLabel = "", class: className = "", ...rest } = Astro.props;
---

<div {...rest} class:list={["offcanvas", `offcanvas-${placement}`, "sheet", className]} tabindex="-1" id={id} aria-label={ariaLabel || undefined} aria-labelledby={!ariaLabel && title ? `${id}-title` : undefined} data-bs-backdrop={!backdrop ? "false" : undefined} data-bs-scroll={scroll ? "true" : undefined}>{title || Astro.slots.has("header") ? <div class="offcanvas-header">{Astro.slots.has("header") ? <slot name="header" /> : <h2 class="offcanvas-title" id={`${id}-title`}>{title}</h2>}{!Astro.slots.has("header") ? <CloseButton ariaLabel="Close" dismiss="offcanvas" /> : null}</div> : null}<div class="offcanvas-body scroll-fade-y no-scrollbar"><slot /></div></div>
