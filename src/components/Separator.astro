---
interface Props {
  orientation?: "horizontal" | "vertical";
  decorative?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { orientation = "horizontal", decorative = true, class: className = "", ...rest } = Astro.props;
---

{orientation === "vertical" ? (
  <div {...rest} class:list={["vr", className]} aria-hidden={decorative ? "true" : undefined} role={!decorative ? "separator" : undefined} aria-orientation={!decorative ? "vertical" : undefined}></div>
) : (
  <hr {...rest} class={className || undefined} aria-hidden={decorative ? "true" : undefined} />
)}
