---
interface Props {
  label: string;
  text: string;
  placement?: "top" | "right" | "bottom" | "left";
  html?: boolean;
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const { label, text, placement = "top", html = false, href = "#!", class: className = "", ...rest } = Astro.props;
---

<a {...rest} href={href} class:list={["tooltip-trigger", className]} data-bs-toggle="tooltip" data-bs-placement={placement} data-bs-title={text} data-bs-html={html ? "true" : undefined}>{label}</a>
