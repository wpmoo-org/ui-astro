---
interface Props {
  width: string;
  height?: string;
  class?: string;
  [key: string]: unknown;
}

const { width, height = "", class: className = "", ...rest } = Astro.props;
---

<div {...rest} class:list={["skeleton", "placeholder-glow", className]} aria-hidden="true" style={`width: ${width};${height ? ` height: ${height};` : ""}`}>
  <span class="placeholder" style={`width: 100%;${height ? " height: 100%;" : ""}`}></span>
</div>
