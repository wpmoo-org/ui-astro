---
interface Props {
  label?: string;
  ariaLabel?: string;
  id?: string;
  name?: string;
  type?: "text" | "search" | "file" | "email" | "password";
  placeholder?: string;
  value?: string;
  help?: string;
  invalidFeedback?: string;
  ariaInvalid?: boolean;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  describedby?: string;
  dir?: "ltr" | "rtl" | "auto" | "";
  class?: string;
  [key: string]: unknown;
}

const { label = "", ariaLabel = "", id = "", name = "", type = "text", placeholder = "", value = "", help = "", invalidFeedback = "", ariaInvalid = false, required = false, disabled = false, readonly = false, describedby = "", dir = "", class: className = "", ...rest } = Astro.props;
const hasLabel = label.trim().length > 0;
const hasAriaLabel = ariaLabel.trim().length > 0;
if (hasLabel === hasAriaLabel) {
  throw new Error("Input requires exactly one of label or ariaLabel");
}
if (hasLabel && !id.trim()) {
  throw new Error("Visible input labels require id");
}
const describedBy = [describedby, help ? `${id}-help` : "", invalidFeedback ? `${id}-feedback` : ""].filter(Boolean).join(" ");
---

{label ? <label class:list={["form-label", Astro.slots.has("label-extra") ? "d-flex align-items-center justify-content-between" : ""]} for={id || undefined}>{label}{required ? <span class="text-danger"> *</span> : null}<slot name="label-extra" /></label> : null}
<input {...rest} class:list={["form-control", ariaInvalid ? "is-invalid" : "", className]} id={id || undefined} name={name || undefined} type={type} placeholder={placeholder || undefined} value={type === "password" ? undefined : value || undefined} aria-label={ariaLabel || undefined} aria-invalid={ariaInvalid ? "true" : undefined} aria-describedby={describedBy || undefined} required={required} disabled={disabled} readonly={readonly} dir={dir || undefined} />
{help ? <div class="form-text" id={`${id}-help`}>{help}</div> : null}
{invalidFeedback ? <div class="invalid-feedback" id={`${id}-feedback`}>{invalidFeedback}</div> : null}
