---
interface SidebarItem {
  title: string;
  href?: string;
  icon?: string;
  badge?: string | number;
  active?: boolean;
  disabled?: boolean;
  tooltip?: string;
}

interface SidebarGroup {
  label?: string;
  items: SidebarItem[];
}

interface Props {
  side?: "left" | "right";
  variant?: "sidebar" | "floating" | "inset";
  collapsible?: "icon" | "offcanvas" | "none";
  rail?: boolean;
  id?: string;
  ariaLabel?: string;
  ariaLabelledBy?: string;
  defaultOpen?: boolean;
  contained?: boolean;
  storageKey?: string;
  triggerLabel?: string;
  showTrigger?: boolean;
  brand?: string;
  items?: SidebarItem[];
  groups?: SidebarGroup[];
  footerText?: string;
  class?: string;
  [key: string]: unknown;
}

import Icon from "./internal/Icon.astro";

const {
  side = "left",
  variant = "sidebar",
  collapsible = "icon",
  rail = true,
  id = "sidebar",
  ariaLabel = "Sidebar",
  ariaLabelledBy = "",
  defaultOpen = true,
  contained = false,
  storageKey = "",
  triggerLabel = "Toggle sidebar",
  showTrigger = true,
  brand = "",
  items = [],
  groups = [],
  footerText = "",
  class: className = "",
  ...rest
} = Astro.props;

const navigationGroups = groups.length ? groups : items.length ? [{ items }] : [];
---

<div {...rest} class:list={["sidebar-wrapper", contained ? "sidebar-wrapper--contained" : "", className]} data-slot="sidebar-wrapper" data-sidebar-state={defaultOpen ? "expanded" : "collapsed"} data-sidebar-key={storageKey || undefined}>
  {showTrigger ? Astro.slots.has("trigger") ? <slot name="trigger" /> : <button class="btn btn-ghost btn-icon-sm sidebar-trigger" type="button" data-sidebar-trigger data-bs-target={`#${id}`} aria-label={triggerLabel} aria-controls={id} aria-expanded={defaultOpen ? "true" : "false"}><Icon name="panel-left" /></button> : null}
  <aside id={id} class:list={["sidebar", "offcanvas-lg", side === "right" ? "offcanvas-end" : "offcanvas-start"]} tabindex="-1" data-slot="sidebar" aria-label={ariaLabelledBy ? undefined : ariaLabel} aria-labelledby={ariaLabelledBy || undefined} data-side={side} data-variant={variant} data-collapsible={collapsible}>
    <div class="sidebar-inner" data-slot="sidebar-inner">
      {Astro.slots.has("header") ? <slot name="header" /> : brand ? <div class="sidebar-header" data-slot="sidebar-header"><span class="sidebar-brand-mark sidebar-brand-mark--primary"><Icon name="panel-left" /></span><span class="fw-semibold">{brand}</span></div> : null}
      {Astro.slots.has("content") ? <slot name="content" /> : Astro.slots.has("default") ? <div class="sidebar-content scroll-fade-y no-scrollbar" data-slot="sidebar-content"><slot /></div> : navigationGroups.length ? <div class="sidebar-content scroll-fade-y no-scrollbar" data-slot="sidebar-content"><nav aria-label={ariaLabel}>{navigationGroups.map((group) => <section class="sidebar-group" data-slot="sidebar-group">{group.label ? <div class="sidebar-group-label" data-slot="sidebar-group-label">{group.label}</div> : null}<ul class="sidebar-menu" data-slot="sidebar-menu">{group.items.map((item) => <li class="sidebar-menu-item" data-slot="sidebar-menu-item"><a class:list={["sidebar-menu-button", item.active ? "active" : ""]} href={item.disabled ? undefined : item.href || "#"} data-slot="sidebar-menu-button" data-sidebar-tooltip={item.tooltip || item.title} aria-current={item.active ? "page" : undefined} aria-disabled={item.disabled ? "true" : undefined} tabindex={item.disabled ? -1 : undefined}><span class="sidebar-menu-button__lead" aria-hidden="true">{item.icon ? <Icon name={item.icon} /> : null}</span><span class="sidebar-menu-button__text"><span class="sidebar-menu-button__title">{item.title}</span></span>{item.badge !== undefined ? <span class="sidebar-menu-badge" data-slot="sidebar-menu-badge">{item.badge}</span> : null}</a></li>)}</ul></section>)}</nav></div> : null}
      {Astro.slots.has("footer") ? <slot name="footer" /> : footerText ? <div class="sidebar-footer" data-slot="sidebar-footer"><span class="small text-body-secondary">{footerText}</span></div> : null}
    </div>
    {rail && collapsible !== "none" ? <button class="sidebar-rail" type="button" data-sidebar-rail aria-label="Toggle sidebar" tabindex="-1"></button> : null}
  </aside>
  {Astro.slots.has("main") ? <slot name="main" /> : null}
</div>
