---
interface SidebarItem {
  title: string;
  href?: string;
  icon?: string;
  badge?: string | number;
  active?: boolean;
  disabled?: boolean;
  tooltip?: string;
  ariaLabel?: string;
}

interface SidebarGroup {
  label?: string;
  items: SidebarItem[];
}

interface Props {
  side?: "left" | "right";
  variant?: "sidebar" | "floating" | "inset";
  collapsible?: "icon" | "offcanvas" | "none";
  rail?: boolean;
  id?: string;
  ariaLabel?: string;
  ariaLabelledBy?: string;
  brand?: string;
  brandHref?: string;
  items?: SidebarItem[];
  groups?: SidebarGroup[];
  footerText?: string;
  class?: string;
  [key: string]: unknown;
}

import Icon from "./internal/Icon.astro";
import { navigationHref } from "../internal/href.js";

const {
  side = "left",
  variant = "sidebar",
  collapsible = "icon",
  rail = true,
  id = "sidebar",
  ariaLabel = "Sidebar",
  ariaLabelledBy = "",
  brand = "",
  brandHref = "/",
  items = [],
  groups = [],
  footerText = "",
  class: className = "",
  slot: _slot,
  ...rest
} = Astro.props;

const navigationGroups = groups.length ? groups : items.length ? [{ items }] : [];
const resolvedBrandHref = navigationHref(brandHref, "Sidebar brandHref");
if (!["left", "right"].includes(side)) throw new TypeError("Sidebar side is unsupported");
if (!["sidebar", "floating", "inset"].includes(variant)) throw new TypeError("Sidebar variant is unsupported");
if (!["icon", "offcanvas", "none"].includes(collapsible)) throw new TypeError("Sidebar collapsible is unsupported");
if (typeof rail !== "boolean") throw new TypeError("Sidebar rail must be boolean");
if (typeof id !== "string" || id === "main-content" || !/^[A-Za-z][A-Za-z0-9_-]*$/.test(id)) {
  throw new TypeError("Sidebar id is invalid");
}
if (typeof ariaLabel !== "string" || typeof ariaLabelledBy !== "string") {
  throw new TypeError("Sidebar accessibility labels must be strings");
}
for (const [groupIndex, group] of navigationGroups.entries()) {
  for (const [itemIndex, item] of group.items.entries()) {
    for (const [field, value] of Object.entries({ title: item.title, ariaLabel: item.ariaLabel ?? item.title })) {
      if (typeof value !== "string" || !value.trim() || /[\x00-\x1f\x7f]/u.test(value)) {
        throw new TypeError(`Sidebar groups[${groupIndex}].items[${itemIndex}].${field} must be nonempty plain text`);
      }
    }
  }
}
---

<aside {...rest} id={id} class:list={["sidebar", "offcanvas-lg", side === "right" ? "offcanvas-end" : "offcanvas-start", className]} tabindex="-1" data-slot="sidebar" aria-label={ariaLabelledBy ? undefined : ariaLabel} aria-labelledby={ariaLabelledBy || undefined} data-side={side} data-variant={variant} data-collapsible={collapsible}>
  <div class="sidebar-inner" data-slot="sidebar-inner">
    {Astro.slots.has("header") ? <slot name="header" /> : brand ? <div class="sidebar-header" data-slot="sidebar-header"><a class="sidebar-menu-button sidebar-menu-button--lg" href={resolvedBrandHref} data-slot="sidebar-menu-button" data-sidebar-tooltip={brand} aria-label={brand}><span class="sidebar-menu-button__lead" aria-hidden="true"><span class="sidebar-brand-mark sidebar-brand-mark--primary"><Icon name="panel-left" /></span></span><span class="sidebar-menu-button__text"><span class="sidebar-menu-button__title">{brand}</span></span></a></div> : null}
    {Astro.slots.has("content") ? <slot name="content" /> : Astro.slots.has("default") ? <div class="sidebar-content scroll-fade-y no-scrollbar" data-slot="sidebar-content"><slot /></div> : navigationGroups.length ? <div class="sidebar-content scroll-fade-y no-scrollbar" data-slot="sidebar-content"><nav aria-label={ariaLabel}>{navigationGroups.map((group) => <section class="sidebar-group" data-slot="sidebar-group">{group.label ? <div class="sidebar-group-label" data-slot="sidebar-group-label">{group.label}</div> : null}<ul class="sidebar-menu" data-slot="sidebar-menu">{group.items.map((item) => <li class="sidebar-menu-item" data-slot="sidebar-menu-item"><a class:list={["sidebar-menu-button", item.active ? "active" : ""]} href={item.disabled ? undefined : item.href || "#"} data-slot="sidebar-menu-button" data-sidebar-tooltip={item.tooltip || item.title} aria-label={item.ariaLabel ?? item.title} aria-current={item.active ? "page" : undefined} aria-disabled={item.disabled ? "true" : undefined} tabindex={item.disabled ? -1 : undefined}><span class="sidebar-menu-button__lead" aria-hidden="true">{item.icon ? <Icon name={item.icon} /> : null}</span><span class="sidebar-menu-button__text"><span class="sidebar-menu-button__title">{item.title}</span></span>{item.badge !== undefined ? <span class="sidebar-menu-badge" data-slot="sidebar-menu-badge">{item.badge}</span> : null}</a></li>)}</ul></section>)}</nav></div> : null}
    {Astro.slots.has("footer") ? <slot name="footer" /> : footerText ? <div class="sidebar-footer" data-slot="sidebar-footer"><span class="small text-body-secondary">{footerText}</span></div> : null}
  </div>
  {rail && collapsible === "icon" ? <button class="sidebar-rail" type="button" data-sidebar-rail aria-label="Toggle sidebar" tabindex="-1"></button> : null}
</aside>
