---
interface Props {
  title?: string;
  subtitle?: string;
  image?: { src: string; alt: string };
  size?: "default" | "sm";
  dir?: "ltr" | "rtl" | "auto" | "";
  headerClass?: string;
  bodyClass?: string;
  footerClass?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  title = "",
  subtitle = "",
  image,
  size = "default",
  class: className = "",
  dir = "",
  headerClass = "",
  bodyClass = "",
  footerClass = "",
  ...rest
} = Astro.props;

const classes = ["card", size === "sm" ? "card--sm" : "", className]
  .filter(Boolean)
  .join(" ");
---

<div {...rest} class={classes} dir={dir || undefined}>
  {image ? <div class="card-image"><img class="card-img-top" src={image.src} alt={image.alt} /></div> : null}
  {title || subtitle || Astro.slots.has("action") ? (
    <div class:list={["card-header", headerClass]}>
      <div class="card-header__text">
        {title && <h3 class="card-title">{title}</h3>}
        {subtitle && <p class="card-subtitle">{subtitle}</p>}
      </div>
      {Astro.slots.has("action") ? <div class="card-action"><slot name="action" /></div> : null}
    </div>
  ) : null}
  <div class:list={["card-body", bodyClass]}>
    <slot />
  </div>
  {Astro.slots.has("footer") ? <div class:list={["card-footer", footerClass]}><slot name="footer" /></div> : null}
</div>
