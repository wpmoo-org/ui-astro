---
interface Props {
  name: string;
  position?: "inline-start" | "inline-end";
}

const { name, position = "inline-start" } = Astro.props;
---

<svg data-icon={position} data-lucide={name} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "loader-circle" ? <path d="M21 12a9 9 0 1 1-6.219-8.56" /> : null}
  {name === "chevron-down" ? <path d="m6 9 6 6 6-6" /> : null}
  {name === "chevron-left" ? <path d="m15 18-6-6 6-6" /> : null}
  {name === "chevron-right" ? <path d="m9 18 6-6-6-6" /> : null}
  {name === "chevrons-left" ? <path d="m11 17-5-5 5-5m7 10-5-5 5-5" /> : null}
  {name === "chevrons-right" ? <path d="m13 17 5-5-5-5M6 17l5-5-5-5" /> : null}
  {name === "chevrons-up-down" ? <path d="m7 15 5 5 5-5M7 9l5-5 5 5" /> : null}
  {name === "ellipsis" ? <><circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /></> : null}
  {name === "ellipsis-vertical" ? <><circle cx="12" cy="5" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="12" cy="19" r="1" /></> : null}
  {name === "calendar" ? <><path d="M8 2v4m8-4v4" /><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M3 10h18" /></> : null}
  {name === "calendar-range" ? <><rect width="18" height="18" x="3" y="4" rx="2" /><path d="M16 2v4M3 10h18M8 2v4m9 8h-6m2 4H7m0-4h.01M17 18h.01" /></> : null}
  {name === "check" ? <path d="m20 6-11 11-5-5" /> : null}
  {name === "x" ? <path d="m6 6 12 12M18 6 6 18" /> : null}
  {name === "search" ? <><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></> : null}
  {name === "list-filter" ? <path d="M3 6h18M6 12h12m-9 6h6" /> : null}
  {name === "circle-info" ? <><circle cx="12" cy="12" r="9" /><path d="M12 16v-4m0-4h.01" /></> : null}
  {name === "triangle-alert" ? <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4m0 4h.01" /> : null}
  {name === "panel-left" ? <><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 3v18" /></> : null}
  {name === "plus" ? <path d="M12 5v14m-7-7h14" /> : null}
</svg>
