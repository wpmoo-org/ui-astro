---
import type { CollectionEntry } from "astro:content";
import type { ComponentProps } from "astro/types";
import { getEntryHref } from "@wpmoo/astro/context";
import type { PartsInput } from "@wpmoo/astro/config";
import Loop from "@wpmoo/astro/views/Loop.astro";
import Typography from "@wpmoo/astro/components/Typography.astro";
interface Props {
  entries: CollectionEntry<"post">[];
  parts: PartsInput;
  lang: string;
}
const { entries, parts, lang } = Astro.props;
const items: ComponentProps<typeof Loop>["items"] = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  href: getEntryHref("post", entry),
  date: entry.data.published_at,
  entryContext: { type: "post", id: entry.id, source: "markdown" },
}));
---

<Typography variant="section-label" content="Theme-selected Loop" />
<Loop items={items} parts={parts} lang={lang} />
