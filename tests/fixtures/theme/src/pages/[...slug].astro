---
import { render } from "astro:content";
import { getPagePaths } from "@wpmoo/astro/plugins/page/queries";
import { getSiteContext } from "@wpmoo/astro/context";
import { resolvePageOptions } from "@wpmoo/astro/config";
import Single from "@wpmoo/astro/plugins/page/views/Single.astro";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

export async function getStaticPaths() {
  const { site } = getSiteContext();
  return (
    await getPagePaths({
      lang: site.defaults.lang,
      reservedPrefixes: ["/posts"],
    })
  ).filter((path) => path.props.entry.id !== "about.md");
}
const { entry } = Astro.props;
const { site } = getSiteContext();
const options = resolvePageOptions(site, "page", "single", entry.data.options);
const entryContext = {
  type: "page",
  id: entry.id,
  source: "markdown" as const,
};
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  options={options}
  pageContext={{ view: "single", entry: entryContext }}
>
  <Single entry={entry} parts={options.parts}>
    <Hero
      slot="page-header"
      id="page-hero"
      heading="page-title"
      title={entry.data.title}
      description={entry.data.description ?? "Theme-composed Page header."}
      parts={options.parts}
    />
    <Content />
  </Single>
</Layout>
