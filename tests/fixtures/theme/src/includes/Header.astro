---
import Header from "@wpmoo/astro/includes/Header.astro";
import Button from "@wpmoo/astro/components/Button.astro";
interface Props {
  homeHref: string;
}
const { homeHref } = Astro.props;
---

<Header>
  <Button slot="actions" element="a" href={homeHref} variant="outline" size="sm"
    >Theme home</Button
  >
</Header>
