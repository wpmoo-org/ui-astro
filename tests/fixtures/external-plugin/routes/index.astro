---
import Layout from "@wpmoo/astro/Layout.astro";
import Header from "@wpmoo/astro/includes/Header.astro";
import Sidebar from "@wpmoo/astro/includes/Sidebar.astro";
import Footer from "@wpmoo/astro/includes/Footer.astro";
import Typography from "@wpmoo/astro/components/Typography.astro";
import { getSiteContext, getSiteNavigation } from "@wpmoo/astro/context";
import { resolvePageOptions } from "@wpmoo/astro/config";
import { getPublishedSamples, sampleLoopItems } from "../queries.js";
import Archive from "../views/Archive.astro";
import Loop from "../views/Loop.astro";

export const prerender = true;
const { site } = getSiteContext();
const { sidebar, ...options } = resolvePageOptions(site, "sample", "archive");
const items = sampleLoopItems(await getPublishedSamples());
const navigation = await getSiteNavigation(Astro.url.pathname);
const groups = [
  {
    items: navigation.map((item) => ({
      title: item.label,
      href: item.href,
      active: item.active,
    })),
  },
];
const homeHref = navigation[0]?.href ?? Astro.url.pathname;
const breadcrumbs = [{ label: "Samples" }];
const layoutProps = {
  ...options,
  title: "Samples",
  pageContext: { view: "archive" as const, type: "sample" },
};
---

{
  sidebar ? (
    <Layout
      {...layoutProps}
      sidebar
      sidebarId="sample-sidebar"
      sidebarKey="sample"
      defaultOpen={sidebar.defaultOpen}
    >
      <Sidebar
        slot="sidebar"
        id="sample-sidebar"
        brand={site.brand}
        brandHref={homeHref}
        groups={groups}
        parts={options.parts}
        side={sidebar.side}
        variant={sidebar.variant}
        collapsible={sidebar.collapsible}
        rail={sidebar.rail}
      />
      <Header slot="header" parts={options.parts} breadcrumbs={breadcrumbs} />
      <Archive
        title="Samples"
        items={items}
        parts={options.parts}
        lang={options.lang}
      >
        <section slot="after-list" aria-labelledby="reused-loop">
          <Typography
            variant="section-title"
            id="reused-loop"
            content="Reusable sample Loop"
          />
          <Loop
            items={items}
            parts={options.parts}
            lang={options.lang}
            titleVariant="subsection-title"
          />
        </section>
      </Archive>
      <Footer
        slot="footer"
        parts={options.parts}
        brand={site.brand}
        homeHref={homeHref}
      />
    </Layout>
  ) : (
    <Layout {...layoutProps}>
      <Header slot="header" parts={options.parts} breadcrumbs={breadcrumbs} />
      <Archive
        title="Samples"
        items={items}
        parts={options.parts}
        lang={options.lang}
      >
        <section slot="after-list" aria-labelledby="reused-loop">
          <Typography
            variant="section-title"
            id="reused-loop"
            content="Reusable sample Loop"
          />
          <Loop
            items={items}
            parts={options.parts}
            lang={options.lang}
            titleVariant="subsection-title"
          />
        </section>
      </Archive>
      <Footer
        slot="footer"
        parts={options.parts}
        brand={site.brand}
        homeHref={homeHref}
      />
    </Layout>
  )
}
