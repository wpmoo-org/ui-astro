---
import { render } from "astro:content";
import { getPagePaths } from "@wpmoo/astro/plugins/page/queries";
import { getEntryHref, getSiteContext } from "@wpmoo/astro/context";
import { resolvePageOptions } from "@wpmoo/astro/config";
import Layout from "@wpmoo/astro/Layout.astro";
import Header from "@wpmoo/astro/includes/Header.astro";
import Sidebar from "@wpmoo/astro/includes/Sidebar.astro";
import Footer from "@wpmoo/astro/includes/Footer.astro";
import Single from "@wpmoo/astro/views/Single.astro";
import Text from "../components/sections/Text.astro";
import Action from "../components/sections/Action.astro";

export const getStaticPaths = () => getPagePaths();
const { entry } = Astro.props;
const { site } = getSiteContext();
const { sidebar, ...options } = resolvePageOptions(
  site,
  "page",
  "single",
  entry.data.options,
);
const { Content } = await render(entry);
const href = getEntryHref("page", entry);
const entryContext = {
  type: "page",
  id: entry.id,
  source: "markdown" as const,
  taxonomies: Object.fromEntries(
    Object.entries(entry.data.taxonomies ?? {}).map(([key, references]) => [
      key,
      references.map((reference) => reference.id),
    ]),
  ),
};
// The host chooses explicit renderers; the package does not discover section files.
const sectionComponents = { text: Text, action: Action };
const SectionText = sectionComponents.text;
const SectionAction = sectionComponents.action;
const groups = [
  {
    items: [
      {
        title: "Editable Page",
        href: "/editable",
        active: href === "/editable",
      },
      { title: "Plain Page", href: "/plain", active: href === "/plain" },
      { title: "Directory sample", href: "/sample/sample-member" },
    ],
  },
];
const layoutProps = {
  ...options,
  title: entry.data.title,
  pageContext: { view: "single" as const, entry: entryContext },
};
const breadcrumbs = [
  { label: site.brand, href: "/editable" },
  { label: entry.data.title },
];
---

{
  sidebar ? (
    <Layout
      {...layoutProps}
      sidebar
      sidebarId="editable-sidebar"
      sidebarKey="editable"
      defaultOpen={sidebar.defaultOpen}
    >
      <Sidebar
        slot="sidebar"
        id="editable-sidebar"
        brand={site.brand}
        brandHref="/editable"
        groups={groups}
        parts={options.parts}
        side={sidebar.side}
        variant={sidebar.variant}
        collapsible={sidebar.collapsible}
        rail={sidebar.rail}
      />
      <Header slot="header" parts={options.parts} breadcrumbs={breadcrumbs} />
      <Single
        title={entry.data.title}
        parts={options.parts}
        entryContext={entryContext}
      >
        <Content />
        {(entry.data.sections ?? []).map((section) =>
          section.type === "text" ? (
            <SectionText id={section.id} {...section.props} />
          ) : (
            <SectionAction id={section.id} {...section.props} />
          ),
        )}
      </Single>
      <Footer
        slot="footer"
        parts={options.parts}
        brand={site.brand}
        homeHref="/editable"
      />
    </Layout>
  ) : (
    <Layout {...layoutProps}>
      <Header slot="header" parts={options.parts} breadcrumbs={breadcrumbs} />
      <Single
        title={entry.data.title}
        parts={options.parts}
        entryContext={entryContext}
      >
        <Content />
        {(entry.data.sections ?? []).map((section) =>
          section.type === "text" ? (
            <SectionText id={section.id} {...section.props} />
          ) : (
            <SectionAction id={section.id} {...section.props} />
          ),
        )}
      </Single>
      <Footer
        slot="footer"
        parts={options.parts}
        brand={site.brand}
        homeHref="/editable"
      />
    </Layout>
  )
}
