---
import type { GetStaticPathsOptions } from "astro";
import type { CollectionEntry } from "astro:content";
import Post from "../../../../../src/views/Post.astro";
import { getPilotPostPaths } from "../../../../../src/routes.js";
interface Props {
  entry: CollectionEntry<"post">;
}
export const prerender = true;
export function getStaticPaths({ routePattern }: GetStaticPathsOptions) {
  return getPilotPostPaths(routePattern);
}
---

<Post entry={Astro.props.entry} />
