---
import type { ComponentProps } from "astro/types";
import Layout from "@wpmoo/astro/Layout.astro";
import Header from "@wpmoo/astro/includes/Header.astro";
import Sidebar from "@wpmoo/astro/includes/Sidebar.astro";
import Footer from "@wpmoo/astro/includes/Footer.astro";
import Button from "@wpmoo/astro/components/Button.astro";
import DropdownMenu from "@wpmoo/astro/components/DropdownMenu.astro";
import type { LanguageLink } from "@wpmoo/astro/i18n";
import { getSiteContext } from "@wpmoo/astro/context";
import type { PageOptions } from "@wpmoo/astro/config";
import { getDemoLanguageLabel, getDemoMessages } from "../messages.js";
import { getDemoNavigation } from "../navigation.js";
import { demoControls, getDemoOptions } from "../settings.js";

type Props = ComponentProps<typeof Layout> & {
  sidebarOptions?: PageOptions["sidebar"];
  languageLinks?: readonly LanguageLink[];
  breadcrumbItems?: readonly { label: string; href?: string }[];
};
const {
  title,
  sidebar,
  sidebarOptions,
  languageLinks = [],
  breadcrumbItems,
  ...options
} = Astro.props;
const context = getSiteContext();
const pageContext = options.pageContext;
const type =
  pageContext?.view === "single"
    ? pageContext.entry.type
    : pageContext?.view === "archive"
      ? pageContext.type
      : pageContext?.view === "taxonomy"
        ? pageContext.taxonomy
        : "page";
const view =
  pageContext?.view === "archive" || pageContext?.view === "taxonomy"
    ? "archive"
    : "single";
const defaults = getDemoOptions(
  type,
  view,
  { parts: options.parts, lang: options.lang },
  context.i18n ? (options.lang ?? Astro.currentLocale) : undefined,
);
const { lang, parts } = defaults;
const selectedSidebar =
  sidebarOptions === undefined ? defaults.sidebar : sidebarOptions;
const enabledSidebar = sidebar ?? selectedSidebar !== null;
const copy = getDemoMessages(lang);
const { groups, homeHref, homeLabel } = await getDemoNavigation(
  Astro.url.pathname,
  lang,
);
const breadcrumbs = [
  { label: context.site.brand, href: homeHref },
  ...(breadcrumbItems ?? [{ label: title }]),
];
const { sidebar: _sidebar, ...layoutDefaults } = defaults;
const layoutProps = {
  ...layoutDefaults,
  ...options,
  title,
  lang,
  parts,
  skipText: options.skipText ?? parts.header.skipLabel,
};
const sidebarId = options.sidebarId ?? demoControls.sidebar.id;
const sidebarKey = options.sidebarKey ?? demoControls.sidebar.key;
const languageItems = languageLinks.map((link) => ({
  label: getDemoLanguageLabel(link.locale),
  href: link.href,
  active: link.locale === lang,
}));
---

{
  enabledSidebar ? (
    <Layout
      {...layoutProps}
      sidebar
      sidebarId={sidebarId}
      sidebarKey={sidebarKey}
      defaultOpen={options.defaultOpen ?? selectedSidebar?.defaultOpen ?? true}
    >
      <Sidebar
        slot="sidebar"
        id={sidebarId}
        brand={context.site.brand}
        brandHref={homeHref}
        parts={parts}
        groups={groups}
        side={selectedSidebar?.side}
        variant={selectedSidebar?.variant}
        collapsible={selectedSidebar?.collapsible}
        rail={selectedSidebar?.rail}
        ariaLabel={copy.examples}
      >
        <span slot="footer" class:list={demoControls.sidebarFooterUtilities}>
          {context.site.brand}
        </span>
      </Sidebar>
      <Header
        slot="header"
        parts={parts}
        breadcrumbs={breadcrumbs}
        ariaLabel={parts.header.breadcrumbLabel}
      >
        {languageItems.length > 1 ? (
          <DropdownMenu
            slot="actions"
            label={copy.language}
            ariaLabel={copy.choosePageLanguage}
            items={languageItems}
            class="ms-auto"
            size="sm"
            align="end"
          />
        ) : (
          <Button
            slot="actions"
            element="a"
            href={homeHref}
            {...demoControls.action}
          >
            {homeLabel}
          </Button>
        )}
      </Header>
      <slot />
      <Footer
        slot="footer"
        parts={parts}
        homeHref={homeHref}
        brand={context.site.brand}
      />
    </Layout>
  ) : (
    <Layout {...layoutProps}>
      <Header
        slot="header"
        parts={parts}
        breadcrumbs={breadcrumbs}
        ariaLabel={parts.header.breadcrumbLabel}
      >
        {languageItems.length > 1 ? (
          <DropdownMenu
            slot="actions"
            label={copy.language}
            ariaLabel={copy.choosePageLanguage}
            items={languageItems}
            class="ms-auto"
            size="sm"
            align="end"
          />
        ) : (
          <Button
            slot="actions"
            element="a"
            href={homeHref}
            {...demoControls.action}
          >
            {homeLabel}
          </Button>
        )}
      </Header>
      <slot />
      <Footer
        slot="footer"
        parts={parts}
        homeHref={homeHref}
        brand={context.site.brand}
      />
    </Layout>
  )
}
