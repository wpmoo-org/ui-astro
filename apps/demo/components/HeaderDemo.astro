---
import SiteLayout from "@wpmoo/astro/layouts/SiteLayout.astro";
import Typography from "@wpmoo/astro/components/Typography.astro";
import { getSiteContext } from "@wpmoo/astro/context";
import { getDemoOptions } from "../settings.js";

interface Props { surface: "default" | "dark" }
const { surface } = Astro.props;
const { site } = getSiteContext();
const options = getDemoOptions("page", "single", {
  theme: "light",
  sidebar: { mode: "header", breakpoint: "lg" },
  parts: { header: { surface } },
});
const href = Astro.url.pathname;
const title = surface === "dark" ? "Header, dark surface" : "Header, default surface";
---

<SiteLayout title={title} options={options} href={href} locale={site.defaults.lang}>
  <a slot="header-utility" class="nav-link small py-1 px-2" href="/contact">Header utility slot</a>
  <Typography variant="page-title" content={title} />
  <p>
    Desktop (lg and up) shows the logo, the main row and a utility row above it.
    Contact is a utility item, Setup guide is drawer-only.
    Below lg every item is in the drawer.
  </p>
</SiteLayout>
