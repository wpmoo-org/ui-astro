---
import Layout from "../layouts/Layout.astro";
import Archive from "@wpmoo/astro/views/Archive.astro";
import { resolvePageOptions } from "@wpmoo/astro/config";
import { getSiteContext } from "@wpmoo/astro/context";
import { resolveSeoMetadata } from "@wpmoo/astro/seo";
import type { TaxonomyPath } from "@wpmoo/astro/taxonomies/queries";

type Props = TaxonomyPath["props"];

const { taxonomy, term, href, breadcrumbs, items, locale, alternates } =
  Astro.props;
const { site } = getSiteContext();
const { sidebar, ...options } = resolvePageOptions(
  site,
  taxonomy,
  "archive",
  undefined,
  locale,
);
const metadata = Astro.site
  ? resolveSeoMetadata(site, {
      title: term.name,
      description: term.description,
      status: "publish",
      type: taxonomy,
      view: "archive",
      lang: options.lang,
      url: new URL(href, Astro.site).href,
      alternates: alternates?.map((link) => ({
        locale: link.locale,
        url: new URL(link.href, Astro.site).href,
      })),
    })
  : undefined;
---

<Layout
  {...options}
  title={term.name}
  description={term.description}
  metadata={metadata}
  sidebarOptions={sidebar}
  languageLinks={alternates}
  breadcrumbItems={breadcrumbs.slice(1)}
  pageContext={{ view: "taxonomy", taxonomy, term: term.id }}
>
  <Archive
    title={term.name}
    description={term.description}
    items={[...items]}
    parts={options.parts}
    lang={options.lang}
  />
</Layout>
