---
import type { GetStaticPathsOptions } from "astro";
import Taxonomy from "../../../views/Taxonomy.astro";
import { getDemoTaxonomyPaths } from "../../../settings.js";
import type { TaxonomyPath } from "@wpmoo/astro/taxonomies/queries";

type Props = TaxonomyPath["props"];

export const prerender = true;
export function getStaticPaths({ routePattern }: GetStaticPathsOptions) {
  return getDemoTaxonomyPaths(routePattern);
}
---

<Taxonomy {...Astro.props} />
