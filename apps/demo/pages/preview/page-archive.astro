---
import {
  demoPageArchiveTranslationKeys,
  getDemoOptions,
} from "../../settings.js";
import Layout from "../../layouts/Layout.astro";
import PageArchive from "@wpmoo/astro/plugins/page/views/Archive.astro";
import { getPublishedPages } from "@wpmoo/astro/plugins/page/queries";
import { getSiteContext } from "@wpmoo/astro/context";
import { getDemoMessages } from "../../messages.js";

const lang = Astro.currentLocale ?? getSiteContext().site.defaults.lang;
const locale = getSiteContext().i18n ? lang : undefined;
const entries = (await getPublishedPages({ locale })).filter(
  (entry) =>
    entry.data.translationKey !== undefined &&
    demoPageArchiveTranslationKeys.includes(entry.data.translationKey),
);
const copy = getDemoMessages(lang);
const preferences = getDemoOptions("page", "archive");
---

<Layout
  parts={preferences.parts}
  title="Page archive preview"
  pageContext={{ view: "archive", type: "page" }}
  lang={lang}
>
  <PageArchive
    parts={preferences.parts}
    title="Pages"
    entries={entries}
    lang={lang}
    locale={locale}
    emptyText={copy.emptyPages}
  />
</Layout>
