---
import type { ImageMetadata } from "astro";
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "@wpmoo/astro/includes/PageHeader.astro";
import ImageGallery from "@wpmoo/astro/blocks/ImageGallery.astro";
import { getSiteContext } from "@wpmoo/astro/context";
import { getDemoBreadcrumbs } from "../../../navigation.js";

const { site } = getSiteContext();
const locale = Astro.currentLocale ?? site.defaults.lang;
// Drawn landscapes from the Moo UI catalog, resized through astro:assets.
const files = import.meta.glob<{ default: ImageMetadata }>("../../../assets/gallery/*.webp", {
  eager: true,
});
const images = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, module]) => {
    const name = path.split("/").pop()!.replace(".webp", "").replaceAll("-", " ");
    return {
      src: module.default,
      alt: name.charAt(0).toUpperCase() + name.slice(1),
      credit: "Drawn for the Moo UI catalog",
    };
  });
---

<Layout title="Image gallery" lang={locale}>
  <PageHeader
    breadcrumbs={await getDemoBreadcrumbs("Image gallery", locale)}
    title="Image gallery"
    description="Thumbnails in four layouts and one lightbox, resized through astro:assets."
  />
  <div class="d-grid gap-5">
    <ImageGallery id="gallery-justified" images={images} layout="justified" />
    <ImageGallery id="gallery-grid" images={images.slice(0, 6)} ratio="3x2" />
    <ImageGallery id="gallery-masonry" images={images} layout="masonry" limit="all" />
    <ImageGallery
      id="gallery-featured"
      images={images.slice(0, 7)}
      layout="featured"
      ratio="1x1"
      columns={{ xs: 3 }}
      labels={{
        title: "Fotos",
        close: "Schließen",
        previous: "Zurück",
        next: "Weiter",
        play: "Diashow starten",
        pause: "Diashow anhalten",
        progress: "Zeit bis zum nächsten Foto",
        fullscreen: "Vollbild",
        exitFullscreen: "Vollbild beenden",
        counter: "{current} von {total}",
        showAll: "Alle {total} Fotos anzeigen",
      }}
    />
  </div>
</Layout>
