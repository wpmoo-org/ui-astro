---
import { getDemoOptions } from "../../settings.js";
import Layout from "../../layouts/Layout.astro";
import Single from "@wpmoo/astro/views/Single.astro";
import type { EntryClassContext } from "@wpmoo/astro/config";
import { getDemoBreadcrumbs } from "../../navigation.js";

const entryContext: EntryClassContext = {
  type: "post",
  id: "announcement.md",
  source: "markdown",
  taxonomies: { category: ["company"], tag: ["astro"] },
};
const preferences = getDemoOptions("post", "single");
---

<Layout
  parts={preferences.parts}
  title="Single preview"
  pageContext={{ view: "single", entry: entryContext }}
>
  <Single
    breadcrumbs={await getDemoBreadcrumbs("Single preview", preferences.lang)}
    parts={preferences.parts}
    title="A sample post"
    description="A common Single view composed with published Moo UI components."
    entryContext={entryContext}
  >
    <p>This paragraph is site-owned content in the generic Single view.</p>
  </Single>
</Layout>
