---
import { getDemoOptions } from "../../settings.js";
import Layout from "../../layouts/Layout.astro";
import PageArchive from "@wpmoo/astro/plugins/page/views/Archive.astro";
import { getPublishedPages } from "@wpmoo/astro/plugins/page/queries";
import { getSiteContext } from "@wpmoo/astro/context";
import { getDemoMessages } from "../../messages.js";

const entries = await getPublishedPages();
const lang = Astro.currentLocale ?? getSiteContext().site.defaults.lang;
const copy = getDemoMessages(lang);
const preferences = getDemoOptions("page", "archive");
---

<Layout parts={preferences.parts} title="Page archive preview" pageContext={{ view: "archive", type: "page" }} lang={lang}>
  <PageArchive parts={preferences.parts} title="Pages" entries={entries} lang={lang} emptyText={copy.emptyPages} />
</Layout>
