---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Single from "@wpmoo/astro/plugins/page/views/Single.astro";
import { getPagePaths } from "@wpmoo/astro/plugins/page/queries";
import { resolvePageOptions } from "@wpmoo/astro/config";
import { getSiteContext } from "@wpmoo/astro/context";

export const prerender = true;
export async function getStaticPaths() {
  const { site, plugins } = getSiteContext();
  return getPagePaths({
    lang: site.defaults.lang,
    reservedPrefixes: plugins.filter((plugin) => plugin.id !== "page").map((plugin) => plugin.basePath),
  });
}

const { entry } = Astro.props;
const { site } = getSiteContext();
const options = resolvePageOptions(site, "page", "single", entry.data.layout);
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={options.sidebar !== null}
  sidebarId="moo-site-sidebar"
  sidebarKey="moo-site"
  sidebarOptions={options.sidebar}
  shellMode={options.shellMode}
  pageWidth={options.pageWidth}
  headerWidth={options.headerWidth}
  theme={options.theme}
  lang={options.lang}
  dir={options.dir}
  parts={options.parts}
  pageContext={{ view: "single", entry: { type: "page", id: entry.id, source: "markdown" } }}
>
  <Single parts={options.parts} entry={entry}><Content /></Single>
</Layout>
