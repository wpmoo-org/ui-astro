---
import NotFound from "@wpmoo/astro/views/NotFound.astro";
import type { NotFoundOptions } from "@wpmoo/astro/not-found";
interface Props {
  data: NotFoundOptions;
}
const { data } = Astro.props;
const content = { ...data, parts: data.options.parts };
const header = Astro.slots.has("page-header");
const actions = Astro.slots.has("actions");
---

{
  header && actions ? (
    <NotFound {...content}>
      <slot name="page-header" slot="page-header" />
      <slot name="actions" slot="actions" />
    </NotFound>
  ) : null
}
{
  header && !actions ? (
    <NotFound {...content}>
      <slot name="page-header" slot="page-header" />
    </NotFound>
  ) : null
}
{
  !header && actions ? (
    <NotFound {...content}>
      <slot name="actions" slot="actions" />
    </NotFound>
  ) : null
}
{!header && !actions ? <NotFound {...content} /> : null}
