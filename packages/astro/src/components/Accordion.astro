---
interface Item {
  id: string;
  title: string;
  content: string;
  open?: boolean;
  disabled?: boolean;
}
interface Props {
  id: string;
  items: Item[];
  alwaysOpen?: boolean;
  flush?: boolean;
  trustedHtml?: boolean;
  class?: string;
  [key: string]: unknown;
}

import Icon from "./internal/Icon.astro";

const {
  id,
  items,
  alwaysOpen = false,
  flush = true,
  trustedHtml = false,
  class: className = "",
  ...rest
} = Astro.props;

// Optional per-item slots: "action-<id>" sits beside the trigger (for
// example a Switch), "content-<id>" replaces the item's content string.
const parts = await Promise.all(
  items.map(async (item) => ({
    action: Astro.slots.has(`action-${item.id}`)
      ? await Astro.slots.render(`action-${item.id}`)
      : "",
    content: Astro.slots.has(`content-${item.id}`)
      ? await Astro.slots.render(`content-${item.id}`)
      : "",
  })),
);
---

<div
  {...rest}
  class:list={["accordion", "w-100", flush ? "accordion-flush" : "", className]}
  id={id}
>
  {
    items.map((item, index) => {
      const { action, content } = parts[index];
      const panelId = `${id}-${item.id}`;
      const triggerId = `${panelId}-trigger`;
      return (
        <div class="accordion-item">
          <>
            <h3
              class:list={[
                "accordion-header",
                action ? "d-flex align-items-center gap-3" : "",
              ]}
            >
              <button
                class:list={[
                  "accordion-button",
                  !item.open ? "collapsed" : "",
                  item.disabled ? "text-muted" : "",
                ]}
                type="button"
                id={triggerId}
                data-bs-toggle="collapse"
                data-bs-target={`#${panelId}`}
                aria-expanded={item.open ? "true" : "false"}
                aria-controls={panelId}
                disabled={item.disabled}
              >
                {item.title}
                <slot name="icon">
                  <Icon name="chevron-down" position="inline-end" />
                </slot>
              </button>
              {action ? <Fragment set:html={action} /> : null}
            </h3>
            <div
              id={panelId}
              class:list={[
                "accordion-collapse",
                "collapse",
                item.open ? "show" : "",
              ]}
              data-bs-parent={alwaysOpen ? undefined : `#${id}`}
              aria-labelledby={triggerId}
            >
              <div class="accordion-body">
                {content ? (
                  <Fragment set:html={content} />
                ) : trustedHtml ? (
                  <Fragment set:html={item.content} />
                ) : (
                  item.content
                )}
              </div>
            </div>
          </>
        </div>
      );
    })
  }
</div>
