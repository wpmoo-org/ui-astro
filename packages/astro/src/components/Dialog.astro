---
import CloseButton from "./CloseButton.astro";

interface Props {
  id: string;
  title?: string;
  description?: string;
  headerClass?: string;
  /** Extra classes for the body, as Core's dialog_body(extra_class). */
  bodyClass?: string;
  size?: "default" | "sm" | "lg" | "xl" | "fullscreen";
  /** Fill the screen below this breakpoint, as Core's dialog(fullscreen_down). */
  fullscreenDown?: "" | "sm" | "md" | "lg" | "xl" | "xxl";
  centered?: boolean;
  scrollable?: boolean;
  static?: boolean;
  direction?: "" | "ltr" | "rtl" | "auto";
  ariaLabel?: string;
  describedby?: string;
  dismissAriaLabel?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  id,
  title = "",
  description = "",
  headerClass = "",
  bodyClass = "",
  size = "default",
  fullscreenDown = "",
  centered = false,
  scrollable = false,
  static: staticBackdrop = false,
  direction = "",
  ariaLabel = "",
  describedby = "",
  dismissAriaLabel = "Close",
  class: className = "",
  ...rest
} = Astro.props;
if (!["", "sm", "md", "lg", "xl", "xxl"].includes(fullscreenDown)) {
  throw new TypeError(`Unknown Dialog fullscreenDown breakpoint: ${fullscreenDown}`);
}
const dialogClasses = [
  "modal-dialog",
  size !== "default" ? `modal-${size}` : "",
  fullscreenDown ? `modal-fullscreen-${fullscreenDown}-down` : "",
  centered ? "modal-dialog-centered" : "",
  scrollable ? "modal-dialog-scrollable" : "",
]
  .filter(Boolean)
  .join(" ");
const descriptionId = description ? `${id}-description` : "";
// A "content" slot lays out the whole dialog, as Core's dialog() caller does.
const rawContent = Astro.slots.has("content");
const showHeader =
  title || description || Astro.slots.has("header") || Astro.slots.has("icon");
---

<div
  {...rest}
  class:list={["modal", "fade", className]}
  id={id}
  tabindex="-1"
  aria-label={ariaLabel || undefined}
  aria-labelledby={!ariaLabel && title ? `${id}-title` : undefined}
  aria-describedby={describedby || descriptionId || undefined}
  aria-hidden="true"
  dir={direction || undefined}
  data-bs-backdrop={staticBackdrop ? "static" : undefined}
  data-bs-keyboard={staticBackdrop ? "false" : undefined}
>
  <div class={dialogClasses}>
    <div class="modal-content">
      {
        rawContent ? (
          <slot name="content" />
        ) : showHeader ? (
          <div class:list={["modal-header", headerClass]}>
            {Astro.slots.has("header") ? (
              <slot name="header" />
            ) : (
              <>
                <slot name="icon" />
                <div>
                  <h1 class="modal-title" id={`${id}-title`}>
                    {title}
                  </h1>
                  {description ? (
                    <p class="modal-description mb-0" id={descriptionId}>
                      {description}
                    </p>
                  ) : null}
                </div>
                <CloseButton ariaLabel={dismissAriaLabel} dismiss="modal" />
              </>
            )}
          </div>
        ) : null
      }
      {rawContent ? null : <div class:list={["modal-body", bodyClass]}><slot /></div>}
      {
        !rawContent && Astro.slots.has("footer") ? (
          <div class="modal-footer">
            <slot name="footer" />
          </div>
        ) : null
      }
    </div>
  </div>
</div>
