---
import Typography from "./Typography.astro";
import DropdownMenu from "./DropdownMenu.astro";
import Icon from "./internal/Icon.astro";
import { navigationHref } from "../internal/href.js";
interface Link {
  label: string;
  href?: string;
  active?: boolean;
  disabled?: boolean;
  badgeLabel?: string;
  badgeVariant?: string;
  icon?: string;
}
interface Item extends Link {
  children?: readonly Link[];
  sections?: readonly { label: string; items: readonly Link[] }[];
  open?: boolean;
}
interface BrandLogo {
  src: string;
  inverseSrc?: string;
  alt: string;
  width: number;
  height: number;
  brandText?: boolean;
}
interface Props {
  heading?: string;
  rootClass?: string;
  ariaLabel: string;
  items?: Item[];
  style?: "base" | "pills" | "underline" | "navbar";
  brand?: string;
  brandHref?: string;
  brandClass?: string;
  brandLogo?: BrandLogo;
  brandSurface?: "light" | "dark";
  utilityItems?: Link[];
  rowsClass?: string;
  linkClass?: string;
  vertical?: boolean;
  dir?: "" | "ltr" | "rtl";
  class?: string;
  [key: string]: unknown;
}

const {
  heading = "",
  rootClass = "",
  ariaLabel,
  items = [],
  style = "pills",
  brand = "",
  brandHref = "/",
  brandClass = "",
  brandLogo,
  brandSurface = "light",
  utilityItems = [],
  rowsClass = "",
  linkClass = "",
  vertical = false,
  dir = "",
  class: className = "",
  ...rest
} = Astro.props;
const navClass =
  style === "base"
    ? "nav"
    : style === "navbar"
      ? "navbar-nav"
      : style === "underline"
        ? "nav nav-underline"
        : "nav nav-pills";
const hasUtility = style === "navbar" && (utilityItems.length > 0 || Astro.slots.has("utility"));
const Rows = hasUtility ? "div" : Fragment;
const rowsProps = hasUtility
  ? { "data-slot": "navigation-rows", class: ["d-flex flex-column-reverse align-items-end gap-1", rowsClass].filter(Boolean).join(" ") }
  : {};
const rootClasses = [style === "navbar" ? "navbar navbar-expand" : "", rootClass].filter(Boolean).join(" ");
---

<nav {...rest} aria-label={ariaLabel} dir={dir || undefined} class={rootClasses || undefined}>
  {brand ? <a href={navigationHref(brandHref, "Navigation brandHref")} class:list={["navbar-brand", brandLogo?.brandText ? "d-flex align-items-center gap-2" : "", brandClass]} data-slot="navigation-brand">{brandLogo ? (
    <>
      {brandLogo.inverseSrc ? (
        <picture class="d-block">
          <source media="(forced-colors: active) and (prefers-color-scheme: dark)" srcset={brandLogo.inverseSrc} />
          <source media="(forced-colors: active)" srcset={brandLogo.src} />
          <img src={brandSurface === "dark" ? brandLogo.inverseSrc : brandLogo.src} alt={brandLogo.brandText ? "" : brandLogo.alt} width={brandLogo.width} height={brandLogo.height} class="d-block" data-slot="navigation-brand-logo" />
        </picture>
      ) : <img src={brandLogo.src} alt={brandLogo.brandText ? "" : brandLogo.alt} width={brandLogo.width} height={brandLogo.height} class="d-block" data-slot="navigation-brand-logo" />}
      {brandLogo.brandText ? <span>{brand}</span> : null}
    </>
  ) : brand}</a> : null}
  {heading ? <Typography content={heading} variant="section-label" class="mb-2" /> : null}
  <Rows {...rowsProps}>
  <ul class:list={[navClass, vertical ? "flex-column gap-1" : "", className]} data-slot={style === "navbar" ? "navigation-menu" : undefined}>
    {
      items.map((item) => (
        <li class="nav-item">
          {item.children?.length || item.sections?.length ? (
            <DropdownMenu label={item.label} triggerPresentation="nav-link" disabled={item.disabled} caret align={style === "navbar" ? "end" : ""} activeCurrent="page" triggerClass={`${linkClass} ${item.open ? "active" : ""}`} itemClass={style === "navbar" ? "text-nowrap" : "text-wrap text-break"} items={item.children} groups={item.sections}>
              {item.icon ? <Icon slot="trigger-icon" name={item.icon} /> : null}
            </DropdownMenu>
          ) : <a
            class:list={[
              "nav-link",
              item.active ? "active" : "",
              item.disabled ? "disabled" : "",
              linkClass,
            ]}
            href={item.disabled ? undefined : item.href || "#"}
            aria-disabled={item.disabled ? "true" : undefined}
            tabindex={item.disabled ? -1 : undefined}
            aria-current={item.active ? "page" : undefined}
          >
            {item.icon ? <Icon name={item.icon} /> : null}
            <span>{item.label}</span>
            {item.badgeLabel ? (
              <span
                class:list={[
                  "badge",
                  "rounded-pill",
                  item.badgeVariant
                    ? `text-bg-${item.badgeVariant === "destructive" ? "danger" : item.badgeVariant}`
                    : "text-bg-secondary",
                  "ms-auto",
                ]}
              >
                {item.badgeLabel}
              </span>
            ) : null}
          </a>}
        </li>
      ))
    }<slot />
  </ul>
  {hasUtility ? (
    <ul class="navbar-nav flex-nowrap small" data-slot="navigation-utility">
      {utilityItems.map((item) => (
        <li class="nav-item">
          <a
            class:list={["nav-link", item.active ? "active" : "", item.disabled ? "disabled" : "", linkClass]}
            href={item.disabled ? undefined : navigationHref(item.href || "#", "Navigation utilityItems href")}
            aria-disabled={item.disabled ? "true" : undefined}
            tabindex={item.disabled ? -1 : undefined}
            aria-current={item.active ? "page" : undefined}
          >
            {item.icon ? <Icon name={item.icon} /> : null}
            <span>{item.label}</span>
          </a>
        </li>
      ))}{Astro.slots.has("utility") ? <li class="nav-item d-flex align-items-center"><slot name="utility" /></li> : null}
    </ul>
  ) : null}
  </Rows>
</nav>
