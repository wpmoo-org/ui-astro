---
import Button from "./Button.astro";

interface Item {
  label: string;
  href?: string;
  active?: boolean;
  disabled?: boolean;
  destructive?: boolean;
  shortcut?: string;
  target?: string;
  rel?: string;
  lang?: string;
  hreflang?: string;
}
interface Props {
  element?: "div" | "nav";
  menuClass?: string;
  itemClass?: string;
  label: string;
  items?: readonly Item[];
  groups?: readonly { label?: string; items: readonly Item[] }[];
  menuLabel?: string;
  variant?:
    | "default"
    | "secondary"
    | "outline"
    | "ghost"
    | "destructive"
    | "link"
    | "success"
    | "warning"
    | "info"
    | "light"
    | "dark"
    | "outline-primary"
    | "outline-success"
    | "outline-danger";
  size?: "default" | "xs" | "sm" | "lg";
  align?: "" | "start" | "end";
  caret?: boolean;
  autoClose?: "" | "true" | "false" | "inside" | "outside";
  offset?: string;
  ariaLabel?: string;
  triggerClass?: string;
  triggerPresentation?: "button" | "nav-link";
  disabled?: boolean;
  activeCurrent?: "page" | "true";
  class?: string;
  [key: string]: unknown;
}

const {
  element: Element = "div",
  menuClass = "",
  itemClass = "",
  label,
  items = [],
  groups = [],
  menuLabel = "",
  variant = "outline",
  size = "default",
  align = "",
  caret = false,
  autoClose = "",
  offset = "",
  ariaLabel = "",
  triggerClass = "",
  triggerPresentation = "button",
  disabled = false,
  activeCurrent = "true",
  class: className = "",
  ...rest
} = Astro.props;
if (!["div", "nav"].includes(Element)) throw new TypeError("Invalid DropdownMenu element");
if (!["button", "nav-link"].includes(triggerPresentation)) throw new TypeError("Invalid DropdownMenu trigger presentation");
type Entry = { kind: "item"; item: Item } | { kind: "heading"; label: string } | { kind: "divider" };
const entries: Entry[] = items.map((item) => ({ kind: "item", item }));
for (const group of groups) {
  if (!group.items.length) continue;
  if (entries.length) entries.push({ kind: "divider" });
  if (group.label) entries.push({ kind: "heading", label: group.label });
  entries.push(...group.items.map((item): Entry => ({ kind: "item", item })));
}
---

<Element {...rest} class:list={["dropdown", className]}>
  {triggerPresentation === "nav-link" ? (
    <button
      type="button"
      class:list={["nav-link", caret ? "dropdown-toggle" : "", triggerClass]}
      disabled={disabled}
      data-bs-toggle="dropdown"
      data-bs-offset={offset || undefined}
      data-bs-auto-close={autoClose || undefined}
      aria-expanded="false"
      aria-label={ariaLabel || undefined}
    >
      <slot name="trigger-icon" />
      <slot name="trigger-label">{label}</slot>
    </button>
  ) : <Button
    label={label}
    variant={variant}
    size={size}
    disabled={disabled}
    ariaLabel={ariaLabel}
    class={triggerClass}
    dropdown
    dropdownCaret={caret}
    dropdownOffset={offset}
    dropdownAutoClose={autoClose}
  >
    <slot name="trigger-icon" slot="icon-start" />
    <slot name="trigger-label">{label}</slot>
  </Button>}
  <slot name="after-trigger" />
  <ul class:list={["dropdown-menu", align ? `dropdown-menu-${align}` : "", menuClass]}>
    {
      menuLabel ? (
        <>
          <li>
            <h6 class="dropdown-header">{menuLabel}</h6>
          </li>
          <li>
            <hr class="dropdown-divider" />
          </li>
        </>
      ) : null
    }
    {
      entries.map((entry) => {
        if (entry.kind === "heading") return <li><h6 class="dropdown-header">{entry.label}</h6></li>;
        if (entry.kind === "divider") return <li><hr class="dropdown-divider" /></li>;
        const item = entry.item;
        return (
        <li>
          {item.href ? (
            <a
              class:list={[
                "dropdown-item",
                itemClass,
                item.active ? "active" : "",
                item.disabled ? "disabled" : "",
              ]}
              href={item.disabled ? undefined : item.href}
              target={item.target}
              rel={item.rel}
              lang={item.lang}
              hreflang={item.hreflang}
              aria-disabled={item.disabled ? "true" : undefined}
              tabindex={item.disabled ? -1 : undefined}
              aria-current={item.active ? activeCurrent : undefined}
              data-variant={item.destructive ? "destructive" : undefined}
            >
              <span>{item.label}</span>
              {item.shortcut ? (
                <span class="ms-auto small text-body-secondary">
                  {item.shortcut}
                </span>
              ) : null}
            </a>
          ) : (
            <button
              class:list={["dropdown-item", itemClass, item.active ? "active" : ""]}
              type="button"
              disabled={item.disabled}
              data-variant={item.destructive ? "destructive" : undefined}
            >
              <span>{item.label}</span>
              {item.shortcut ? (
                <span class="ms-auto small text-body-secondary">
                  {item.shortcut}
                </span>
              ) : null}
            </button>
          )}
        </li>
        );
      })
    }
    <slot />
  </ul>
</Element>
