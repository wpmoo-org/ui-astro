---
import ContentBlock from "./ContentBlock.astro";
import TableOfContents from "../blocks/table-of-contents/TableOfContents.astro";
import EntryTaxonomies from "../blocks/entry-taxonomies/EntryTaxonomies.astro";
import type { PlacementPlan, PlacementLocation } from "./index.js";
interface Props { plan: PlacementPlan<unknown>; at: PlacementLocation }
const { plan, at } = Astro.props;
const placements = plan.groups[at] ?? [];
---

{placements.map((placement) => {
  const Component = placement.Component;
  return placement.kind === "toc" ? (
    <TableOfContents headings={plan.context.headings ?? []} depths={placement.props?.depths as number[] | undefined} label={String(placement.props?.label ?? plan.labels.onThisPage ?? "On this page")} />
  ) : placement.kind === "entry-taxonomies" ? (
    <EntryTaxonomies groups={plan.context.assignedTerms} label={String(placement.props?.label ?? plan.labels.taxonomies)} />
  ) : Component && placement.kind === "content" ? (
    <ContentBlock headings={placement.headings ?? []} instanceId={placement.instanceId}>
      <Component {...placement.props} context={plan.context} instanceId={placement.instanceId} links={plan.links} />
    </ContentBlock>
  ) : Component ? (
    <Component {...placement.props} context={plan.context} instanceId={placement.instanceId} links={plan.links} />
  ) : null;
})}
