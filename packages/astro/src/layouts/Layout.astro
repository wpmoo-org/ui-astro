---
import "../styles.css";
import stateSource from "@wpmoo/ui/state.js?raw";
import Button from "../components/Button.astro";
import Icon from "../components/internal/Icon.astro";
import {
  defineSite,
  getPageClasses,
  resolveParts,
  type PageClassContext,
  type PartsInput,
} from "../config/index.js";
import type { SeoMetadata } from "../seo/index.js";

type ShellMode = "viewport" | "contained";
type Theme = "light" | "dark";
type Direction = "ltr" | "rtl";
type PageWidth = "base" | "sm" | "md" | "lg" | "xl" | "xxl" | "fluid";

interface Props {
  title: string;
  description?: string;
  metadata?: SeoMetadata | null;
  sidebar?: boolean;
  shellMode?: ShellMode;
  theme?: Theme;
  lang?: string;
  dir?: Direction;
  sidebarKey?: string;
  defaultOpen?: boolean;
  sidebarId?: string;
  ariaLabel?: string;
  skipText?: string;
  id?: string;
  pageWidth?: PageWidth;
  headerWidth?: PageWidth | null;
  pageContext?: PageClassContext;
  parts?: PartsInput;
}

const containerClasses: Record<PageWidth, string> = {
  base: "container",
  sm: "container-sm",
  md: "container-md",
  lg: "container-lg",
  xl: "container-xl",
  xxl: "container-xxl",
  fluid: "container-fluid",
};
const identifierPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const shellModeValues: ShellMode[] = ["viewport", "contained"];
const themeValues: Theme[] = ["light", "dark"];
const directionValues: Direction[] = ["ltr", "rtl"];

const defaults = defineSite().defaults;
const parts = resolveParts(Astro.props.parts);
const {
  title,
  description,
  metadata,
  sidebar = false,
  shellMode = defaults.shellMode,
  theme = defaults.theme,
  lang = defaults.lang,
  dir = defaults.dir,
  sidebarKey = "",
  defaultOpen = true,
  sidebarId = "",
  ariaLabel = parts.header.toggleLabel,
  skipText = parts.header.skipLabel,
  id = "",
  pageWidth = defaults.pageWidth,
  headerWidth = defaults.headerWidth,
  pageContext,
} = Astro.props;

if (typeof sidebar !== "boolean") {
  throw new TypeError("Layout sidebar must be boolean");
}
if (!shellModeValues.includes(shellMode)) {
  throw new TypeError(`Unknown Layout shell mode: ${String(shellMode)}`);
}
if (!themeValues.includes(theme)) {
  throw new TypeError(`Unknown Layout theme: ${String(theme)}`);
}
if (!directionValues.includes(dir)) {
  throw new TypeError(`Unknown Layout direction: ${String(dir)}`);
}
if (typeof lang !== "string" || !lang.trim()) {
  throw new TypeError("Invalid Layout language");
}
if (typeof defaultOpen !== "boolean") {
  throw new TypeError("Layout defaultOpen must be boolean");
}
if (
  typeof ariaLabel !== "string" ||
  !ariaLabel.trim() ||
  /[\x00-\x1f\x7f]/u.test(ariaLabel)
) {
  throw new TypeError("Layout trigger label must be nonempty plain text");
}
if (typeof skipText !== "string" || !skipText.trim()) {
  throw new TypeError("Layout skipText must be nonempty text");
}
if (headerWidth !== null && !Object.hasOwn(containerClasses, headerWidth)) {
  throw new TypeError(`Unknown Layout header width: ${String(headerWidth)}`);
}
if (!Object.hasOwn(containerClasses, pageWidth)) {
  throw new TypeError(`Unknown Layout page width: ${String(pageWidth)}`);
}
if (id && (id === "main-content" || !identifierPattern.test(id))) {
  throw new TypeError("Invalid Layout id");
}
if (sidebar) {
  if (
    !sidebarId ||
    sidebarId === "main-content" ||
    !identifierPattern.test(sidebarId)
  ) {
    throw new TypeError("Invalid Layout sidebarId");
  }
  if (!sidebarKey || !identifierPattern.test(sidebarKey)) {
    throw new TypeError("Invalid Layout sidebarKey");
  }
  if (id && id === sidebarId) {
    throw new TypeError("Layout id and sidebarId must differ");
  }
}

const hasSidebarSlot = Astro.slots.has("sidebar");
if (sidebar && !hasSidebarSlot) {
  throw new TypeError("Layout sidebar requires a sidebar slot");
}
if (!sidebar && hasSidebarSlot) {
  throw new TypeError("Layout without sidebar does not accept a sidebar slot");
}
if (!Astro.slots.has("default")) {
  throw new TypeError("Layout requires default page content");
}

const resolvedHeaderWidth = headerWidth || pageWidth;
const hasHeader = sidebar || Astro.slots.has("header");
const pageClass = containerClasses[pageWidth];
const headerClass = containerClasses[resolvedHeaderWidth];
const pageClasses = getPageClasses(pageContext);
const headTitle = metadata?.title ?? title;
const headDescription = metadata?.description ?? description;
const jsonLd = metadata
  ? JSON.stringify(metadata.jsonLd).replace(
      /[<>&\u2028\u2029]/gu,
      (character) =>
        `\\u${character.charCodeAt(0).toString(16).padStart(4, "0")}`,
    )
  : undefined;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {
      headDescription !== undefined ? (
        <meta name="description" content={headDescription} />
      ) : null
    }
    <link rel="icon" href="data:," />
    <title>{headTitle}</title>
    {
      metadata ? (
        <>
          <link rel="canonical" href={metadata.canonical} />
          {metadata.alternates?.map((item) => (
            <link rel="alternate" hreflang={item.locale} href={item.url} />
          ))}
          {Object.entries(metadata.openGraph).map(([key, value]) => (
            <meta property={`og:${key}`} content={value} />
          ))}
          {Object.entries(metadata.twitter).map(([key, value]) => (
            <meta name={`twitter:${key}`} content={value} />
          ))}
          <script is:inline type="application/ld+json" set:html={jsonLd} />
        </>
      ) : null
    }
  </head>
  <body>
    <div
      class:list={["moo-ui", pageClasses]}
      data-bs-theme={theme}
      data-moo-document-owner="true"
    >
      <script is:inline set:html={stateSource} />
      <Button
        element="a"
        href="#main-content"
        class="visually-hidden-focusable position-absolute top-0 start-0 z-3"
        >{skipText}</Button
      >
      <div
        class="wrapper"
        data-layout="app"
        data-shell-mode={shellMode}
        id={id || undefined}
        data-slot={sidebar ? "sidebar-wrapper" : undefined}
        data-sidebar-state={sidebar
          ? defaultOpen
            ? "expanded"
            : "collapsed"
          : undefined}
        data-sidebar-key={sidebar ? sidebarKey : undefined}
      >
        {sidebar ? <script is:inline set:html={stateSource} /> : null}
        {sidebar ? <slot name="sidebar" /> : null}
        <div data-slot="page">
          <slot name="before-header" />
          {
            hasHeader ? (
              <header class:list={parts.header.utilities}>
                <div class={headerClass}>
                  <div class:list={parts.header.contentUtilities}>
                    {sidebar ? (
                      <Button
                        variant={parts.header.trigger.variant}
                        size={parts.header.trigger.size}
                        class="sidebar-trigger"
                        data-sidebar-trigger
                        data-bs-target={`#${sidebarId}`}
                        ariaLabel={ariaLabel}
                        ariaControls={sidebarId}
                        ariaExpanded={defaultOpen}
                      >
                        <Icon name={parts.header.trigger.icon} />
                      </Button>
                    ) : null}
                    <slot name="header" />
                  </div>
                </div>
              </header>
            ) : null
          }
          <slot name="after-header" />
          <main
            id="main-content"
            tabindex="-1"
            class:list={parts.content.scrollUtilities}
          >
            <div
              class:list={[pageClass, parts.content.utilities]}
              data-page-container
            >
              <slot />
            </div>
          </main>
          <slot name="before-footer" />
          {
            Astro.slots.has("footer") ? (
              <footer class:list={parts.footer.utilities}>
                <div class={pageClass}>
                  <slot name="footer" />
                </div>
              </footer>
            ) : null
          }
          <slot name="after-footer" />
        </div>
      </div>
      <slot name="overlay" />
    </div>
    <script>
      import "../runtime/bootstrap.js";
      import MooUI from "../runtime/moo-ui.js";

      document
        .querySelectorAll('[data-slot="sidebar-wrapper"]')
        .forEach((root) => MooUI.Sidebar.getOrCreateInstance(root));
    </script>
  </body>
</html>
