---
import "../styles.css";
import stateSource from "@wpmoo/ui/state.js?raw";
import Button from "../components/Button.astro";
import Icon from "../components/internal/Icon.astro";
import {
  defineSite,
  getPageClasses,
  resolveParts,
  type PageClassContext,
  type PartsInput,
} from "../config/index.js";
import type { SeoMetadata } from "../seo/index.js";

type ShellMode = "viewport" | "contained" | "document";
type Theme = "light" | "dark";
type Direction = "ltr" | "rtl";
type PageWidth = "base" | "sm" | "md" | "lg" | "xl" | "xxl" | "fluid";

interface Props {
  title: string;
  description?: string;
  metadata?: SeoMetadata | null;
  sidebar?: boolean;
  shellMode?: ShellMode;
  overlayScrollbar?: boolean;
  theme?: Theme;
  lang?: string;
  dir?: Direction;
  sidebarKey?: string;
  defaultOpen?: boolean;
  sidebarId?: string;
  ariaLabel?: string;
  skipText?: string;
  id?: string;
  pageWidth?: PageWidth;
  headerWidth?: PageWidth | null;
  headerTocClass?: string;
  pageContext?: PageClassContext;
  parts?: PartsInput;
}

const containerClasses: Record<PageWidth, string> = {
  base: "container",
  sm: "container-sm",
  md: "container-md",
  lg: "container-lg",
  xl: "container-xl",
  xxl: "container-xxl",
  fluid: "container-fluid",
};
const identifierPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const shellModeValues: ShellMode[] = ["viewport", "contained", "document"];
const themeValues: Theme[] = ["light", "dark"];
const directionValues: Direction[] = ["ltr", "rtl"];

const defaults = defineSite().defaults;
const parts = resolveParts(Astro.props.parts);
const {
  title,
  description,
  metadata,
  sidebar = false,
  shellMode = defaults.shellMode,
  overlayScrollbar = defaults.overlayScrollbar,
  theme = defaults.theme,
  lang = defaults.lang,
  dir = defaults.dir,
  sidebarKey = "",
  defaultOpen = true,
  sidebarId = "",
  ariaLabel = parts.header.toggleLabel,
  skipText = parts.header.skipLabel,
  id = "",
  pageWidth = defaults.pageWidth,
  headerWidth = defaults.headerWidth,
  headerTocClass = "",
  pageContext,
} = Astro.props;

if (typeof sidebar !== "boolean") {
  throw new TypeError("Layout sidebar must be boolean");
}
if (typeof overlayScrollbar !== "boolean") {
  throw new TypeError("Layout overlayScrollbar must be boolean");
}
if (!shellModeValues.includes(shellMode)) {
  throw new TypeError(`Unknown Layout shell mode: ${String(shellMode)}`);
}
if (shellMode === "document" && sidebar) {
  throw new TypeError("Layout document shell mode requires no sidebar");
}
if (!themeValues.includes(theme)) {
  throw new TypeError(`Unknown Layout theme: ${String(theme)}`);
}
if (!directionValues.includes(dir)) {
  throw new TypeError(`Unknown Layout direction: ${String(dir)}`);
}
if (typeof lang !== "string" || !lang.trim()) {
  throw new TypeError("Invalid Layout language");
}
if (typeof defaultOpen !== "boolean") {
  throw new TypeError("Layout defaultOpen must be boolean");
}
if (
  typeof ariaLabel !== "string" ||
  !ariaLabel.trim() ||
  /[\x00-\x1f\x7f]/u.test(ariaLabel)
) {
  throw new TypeError("Layout trigger label must be nonempty plain text");
}
if (typeof skipText !== "string" || !skipText.trim()) {
  throw new TypeError("Layout skipText must be nonempty text");
}
if (headerWidth !== null && !Object.hasOwn(containerClasses, headerWidth)) {
  throw new TypeError(`Unknown Layout header width: ${String(headerWidth)}`);
}
if (!Object.hasOwn(containerClasses, pageWidth)) {
  throw new TypeError(`Unknown Layout page width: ${String(pageWidth)}`);
}
if (id && (id === "main-content" || !identifierPattern.test(id))) {
  throw new TypeError("Invalid Layout id");
}
if (sidebar) {
  if (
    !sidebarId ||
    sidebarId === "main-content" ||
    !identifierPattern.test(sidebarId)
  ) {
    throw new TypeError("Invalid Layout sidebarId");
  }
  if (!sidebarKey || !identifierPattern.test(sidebarKey)) {
    throw new TypeError("Invalid Layout sidebarKey");
  }
  if (id && id === sidebarId) {
    throw new TypeError("Layout id and sidebarId must differ");
  }
}

const hasSidebarSlot = Astro.slots.has("sidebar");
if (sidebar && !hasSidebarSlot) {
  throw new TypeError("Layout sidebar requires a sidebar slot");
}
if (!sidebar && hasSidebarSlot) {
  throw new TypeError("Layout without sidebar does not accept a sidebar slot");
}
if (!Astro.slots.has("default")) {
  throw new TypeError("Layout requires default page content");
}

const resolvedHeaderWidth = headerWidth || pageWidth;
const hasHeader = sidebar || Astro.slots.has("header");
const pageClass = containerClasses[pageWidth];
const headerClass = containerClasses[resolvedHeaderWidth];
const pageClasses = getPageClasses(pageContext);
const headTitle = metadata?.title ?? title;
const headDescription = metadata?.description ?? description;
const jsonLd = metadata
  ? JSON.stringify(metadata.jsonLd).replace(
      /[<>&\u2028\u2029]/gu,
      (character) =>
        `\\u${character.charCodeAt(0).toString(16).padStart(4, "0")}`,
    )
  : undefined;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {
      headDescription !== undefined ? (
        <meta name="description" content={headDescription} />
      ) : null
    }
    <link rel="icon" href="data:," />
    <title>{headTitle}</title>
    {
      metadata ? (
        <>
          <link rel="canonical" href={metadata.canonical} />
          {metadata.alternates?.map((item) => (
            <link rel="alternate" hreflang={item.locale} href={item.url} />
          ))}
          {Object.entries(metadata.openGraph).map(([key, value]) => (
            <meta property={`og:${key}`} content={value} />
          ))}
          {Object.entries(metadata.twitter).map(([key, value]) => (
            <meta name={`twitter:${key}`} content={value} />
          ))}
          <script is:inline type="application/ld+json" set:html={jsonLd} />
        </>
      ) : null
    }
  </head>
  <body>
    <div
      class:list={["moo-ui", pageClasses]}
      data-bs-theme={theme}
      data-moo-document-owner="true"
      data-moo-overlay-scrollbar={overlayScrollbar ? "true" : undefined}
    >
      <script is:inline set:html={stateSource} />
      <Button
        element="a"
        href="#main-content"
        class="visually-hidden-focusable position-absolute top-0 start-0 z-3"
        >{skipText}</Button
      >
      <div
        class="wrapper"
        data-layout="app"
        data-shell-mode={shellMode}
        id={id || undefined}
        data-slot={sidebar ? "sidebar-wrapper" : undefined}
        data-sidebar-state={sidebar
          ? defaultOpen
            ? "expanded"
            : "collapsed"
          : undefined}
        data-sidebar-key={sidebar ? sidebarKey : undefined}
      >
        {sidebar ? <script is:inline set:html={stateSource} /> : null}
        {sidebar ? <slot name="sidebar" /> : null}
        <div data-slot="page">
          <slot name="before-header" />
          {
            hasHeader ? (
              <header class:list={["position-relative z-3", parts.header.utilities]}>
                <div class={headerClass}>
                  <div class:list={parts.header.contentUtilities}>
                    {sidebar ? (
                      <Button
                        variant={parts.header.trigger.variant}
                        size={parts.header.trigger.size}
                        class="sidebar-trigger"
                        data-sidebar-trigger
                        data-bs-target={`#${sidebarId}`}
                        ariaLabel={ariaLabel}
                        ariaControls={sidebarId}
                        ariaExpanded={defaultOpen}
                      >
                        <Icon name={parts.header.trigger.icon} />
                      </Button>
                    ) : null}
                    <slot name="header" />
                  </div>
                </div>
                {Astro.slots.has("header-toc") ? (
                  <div class:list={[headerClass, headerTocClass]} data-header-reading-host>
                    <div class="fade" data-header-reading-bar hidden inert>
                      <div class="row bg-body border-top">
                        <div class="col"><slot name="header-toc" /></div>
                      </div>
                    </div>
                  </div>
                ) : null}
              </header>
            ) : null
          }
          <slot name="after-header" />
          <main
            id="main-content"
            tabindex="-1"
            class:list={shellMode === "document" ? undefined : parts.content.scrollUtilities}
          >
            <div
              class:list={[pageClass, parts.content.utilities]}
              data-page-container
            >
              <slot />
            </div>
          </main>
          <slot name="before-footer" />
          {
            Astro.slots.has("footer") ? (
              <footer class:list={parts.footer.utilities}>
                <div class={pageClass}>
                  <slot name="footer" />
                </div>
              </footer>
            ) : null
          }
          <slot name="after-footer" />
        </div>
      </div>
      <slot name="overlay" />
    </div>
    <script>
      import { bootstrap } from "../runtime/bootstrap.js";
      import MooUI from "../runtime/moo-ui.js";

      const tocInstances = new Set<InstanceType<typeof MooUI.TableOfContents>>();
      const readingBarReleases = new Set<() => void>();
      function initializeReadingBars() {
        readingBarReleases.forEach((release) => release());
        readingBarReleases.clear();
        document.querySelectorAll<HTMLElement>("[data-header-reading-bar]").forEach((panel) => {
          const host = panel.parentElement;
          const owner = panel.closest<HTMLElement>("[data-moo-document-owner]");
          const main = owner?.querySelector<HTMLElement>("#main-content");
          if (!host || !owner || !main || !panel.querySelector("[data-toc]")) return;
          const navs = owner.querySelectorAll<HTMLElement>('[data-toc][data-toc-scroll-root="main-content"]');
          let shown = false;
          let stopped = false;
          let frame = 0;
          let revision = 0;
          let previousHeight = -1;
          let alignedTarget: HTMLElement | null = null;
          let alignedAtBoundary = false;
          let focusWithinPanel = false;
          const focusTargets = new Set<HTMLElement>();
          const focusIn = () => { focusWithinPanel = true; };
          const focusOut = (event: FocusEvent) => {
            if (event.relatedTarget instanceof Node && panel.contains(event.relatedTarget)) return;
            if (event.relatedTarget || panel.getClientRects().length > 0) focusWithinPanel = false;
          };
          const scrollRoot = () => ["auto", "scroll"].includes(getComputedStyle(main).overflowY)
            ? main : document.scrollingElement;
          const update = () => {
            if (stopped) return;
            const root = scrollRoot();
            const compact = getComputedStyle(host).display !== "none";
            const next = compact && (root?.scrollTop ?? 0) > (shown ? 300 : Math.max(360, innerHeight / 2));
            if (shown && !next) {
              const trigger = panel.querySelector<HTMLElement>('[data-bs-toggle="dropdown"][aria-expanded="true"]');
              if (trigger) bootstrap.Dropdown.getInstance(trigger)?.hide();
              if (focusWithinPanel || panel.contains(document.activeElement)) {
                const fallback = Array.from(panel.closest("header")?.querySelectorAll<HTMLElement>('button:not([disabled]), a[href]:not([aria-disabled="true"])') ?? [])
                  .find((element) => !panel.contains(element) && element.getClientRects().length > 0 && getComputedStyle(element).visibility === "visible" && !element.closest("[inert]"));
                (fallback ?? main).focus({ preventScroll: true });
                focusWithinPanel = false;
              }
            }
            shown = next;
            panel.inert = !shown;
            panel.dataset.readingBarVisible = String(shown);
            if (shown && (panel.hidden || !panel.classList.contains("show"))) {
              revision++;
              panel.hidden = false;
              void panel.offsetWidth;
              panel.classList.add("show");
            } else if (!shown && !panel.hidden && panel.classList.contains("show")) {
              panel.classList.remove("show");
              const current = ++revision;
              Promise.allSettled(panel.getAnimations().map((animation) => animation.finished)).then(() => {
                if (!stopped && !shown && revision === current) {
                  panel.hidden = true;
                  schedule();
                }
              });
            }
            const height = compact && !panel.hidden ? panel.getBoundingClientRect().height : 0;
            if (height !== previousHeight) {
              previousHeight = height;
              navs.forEach((nav) => MooUI.TableOfContents.getInstance(nav)?.refresh({ activationOffset: 0 }));
            }
            if (alignedTarget && root) {
              const top = root === document.scrollingElement ? Math.max(0, panel.closest("header")?.getBoundingClientRect().bottom ?? 0) : root.getBoundingClientRect().top;
              alignedAtBoundary = Math.abs(alignedTarget.getBoundingClientRect().top - top) < 2;
            }
          };
          const schedule = () => {
            if (stopped || frame) return;
            frame = requestAnimationFrame(() => { frame = 0; update(); });
          };
          const targetFor = (hash: string) => {
            let target: HTMLElement | null;
            try { target = document.getElementById(decodeURIComponent(hash.slice(1))); }
            catch { return null; }
            return target && main.contains(target) && Array.from(navs).some((nav) =>
              Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')).some((link) => link.hash === hash)
            ) ? target : null;
          };
          const align = (target: HTMLElement, behavior: ScrollBehavior) => {
            const root = scrollRoot();
            if (!root) return;
            update();
            const top = root === document.scrollingElement ? Math.max(0, panel.closest("header")?.getBoundingClientRect().bottom ?? 0) : root.getBoundingClientRect().top;
            alignedTarget = target;
            root.scrollTo({ top: Math.max(0, root.scrollTop + target.getBoundingClientRect().top - top), behavior: behavior === "auto" ? "instant" : behavior });
            if (behavior === "auto") {
              update();
              const settledTop = root === document.scrollingElement ? Math.max(0, panel.closest("header")?.getBoundingClientRect().bottom ?? 0) : root.getBoundingClientRect().top;
              root.scrollTo({ top: Math.max(0, root.scrollTop + target.getBoundingClientRect().top - settledTop), behavior: "instant" });
              update();
            }
          };
          const click = (event: MouseEvent) => {
            if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
            const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('[data-toc] a[href^="#"]') : null;
            const target = link && targetFor(link.hash);
            if (!link || !target) return;
            event.preventDefault();
            if (location.hash !== link.hash) history.pushState(null, "", link.hash);
            align(target, matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth");
            if (event.detail === 0) {
              if (!target.hasAttribute("tabindex") && target.tabIndex < 0) {
                target.tabIndex = -1;
                focusTargets.add(target);
              }
              target.focus({ preventScroll: true });
            }
          };
          const alignHash = () => {
            const target = location.hash && targetFor(location.hash);
            if (target) align(target, "auto");
          };
          const resized = () => {
            if (alignedTarget && alignedAtBoundary) align(alignedTarget, "auto");
            schedule();
          };
          document.addEventListener("scroll", schedule, { passive: true, capture: true });
          window.addEventListener("resize", resized);
          window.addEventListener("hashchange", alignHash);
          window.addEventListener("load", alignHash);
          owner.addEventListener("click", click);
          panel.addEventListener("focusin", focusIn);
          panel.addEventListener("focusout", focusOut);
          const resize = new ResizeObserver(schedule);
          resize.observe(panel);
          resize.observe(host);
          update();
          alignHash();
          document.fonts.ready.then(() => { if (!stopped) alignHash(); });
          readingBarReleases.add(() => {
            stopped = true;
            revision++;
            cancelAnimationFrame(frame);
            resize.disconnect();
            document.removeEventListener("scroll", schedule, true);
            window.removeEventListener("resize", resized);
            window.removeEventListener("hashchange", alignHash);
            window.removeEventListener("load", alignHash);
            owner.removeEventListener("click", click);
            panel.removeEventListener("focusin", focusIn);
            panel.removeEventListener("focusout", focusOut);
            focusTargets.forEach((target) => {
              if (target.getAttribute("tabindex") === "-1") target.removeAttribute("tabindex");
            });
            panel.getAnimations().forEach((animation) => animation.cancel());
            panel.classList.remove("show");
            panel.hidden = true;
            panel.inert = true;
            delete panel.dataset.readingBarVisible;
            navs.forEach((nav) => MooUI.TableOfContents.getInstance(nav)?.refresh({ activationOffset: 0 }));
          });
        });
      }
      const scrollbarReleases = new Set<() => void>();
      function initializeScrollbars() {
        scrollbarReleases.forEach((release) => release());
        scrollbarReleases.clear();
        document.querySelectorAll<HTMLElement>('[data-moo-overlay-scrollbar="true"]').forEach((owner) => {
          const main = owner.querySelector<HTMLElement>("#main-content");
          let scrollElement: Element | null = null;
          let instance: InstanceType<typeof MooUI.OverlayScrollbar> | null = null;
          const synchronize = () => {
            const next = main && ["auto", "scroll"].includes(getComputedStyle(main).overflowY)
              ? main : document.scrollingElement;
            if (next === scrollElement) return;
            instance?.dispose();
            instance = null;
            scrollElement = next;
            if (next) instance = MooUI.OverlayScrollbar.getOrCreateInstance(owner, { scrollElement: next });
          };
          synchronize();
          window.addEventListener("resize", synchronize);
          const resize = new ResizeObserver(synchronize);
          if (main) resize.observe(main);
          resize.observe(owner);
          const mutations = new MutationObserver(synchronize);
          for (let element: Element | null = main ?? owner; element; element = element.parentElement) {
            mutations.observe(element, {
              attributes: true,
              attributeFilter: ["class", "style", "data-shell-mode"],
            });
          }
          scrollbarReleases.add(() => {
            window.removeEventListener("resize", synchronize);
            resize.disconnect();
            mutations.disconnect();
            instance?.dispose();
          });
        });
      }
      function initializeToc() {
        document.querySelectorAll("[data-toc]").forEach((root) => {
          tocInstances.add(MooUI.TableOfContents.getOrCreateInstance(root));
        });
      }
      initializeToc();
      initializeReadingBars();
      initializeScrollbars();
      document.addEventListener("astro:page-load", initializeToc);
      document.addEventListener("astro:page-load", initializeReadingBars);
      document.addEventListener("astro:page-load", initializeScrollbars);
      document.addEventListener("astro:before-swap", () => {
        readingBarReleases.forEach((release) => release());
        readingBarReleases.clear();
        scrollbarReleases.forEach((release) => release());
        scrollbarReleases.clear();
        tocInstances.forEach((instance) => instance.dispose());
        tocInstances.clear();
      });

      document
        .querySelectorAll('[data-slot="sidebar-wrapper"]')
        .forEach((root) => MooUI.Sidebar.getOrCreateInstance(root));
    </script>
  </body>
</html>
