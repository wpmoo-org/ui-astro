---
import Sidebar from "../components/Sidebar.astro";
import CloseButton from "../components/CloseButton.astro";
import type { SiteChrome } from "../site/index.d.ts";
interface Props { chrome: SiteChrome; side: "left" | "right" }
const { chrome, side } = Astro.props;
---

<Sidebar
  id="moo-site-drawer"
  mode="drawer"
  side={side}
  brand={chrome.brand}
  brandHref={chrome.homeHref}
  brandSubtitle={chrome.presentation.brandDescription}
  ariaLabel={chrome.presentation.labels.site}
  groups={chrome.navigation}
  data-site-drawer={side}
>
  <CloseButton
    slot="header-actions"
    ariaLabel={chrome.presentation.labels.closeNavigation}
    dismiss="offcanvas"
    class="flex-shrink-0"
  />
</Sidebar>
