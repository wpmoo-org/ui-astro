---
import TableOfContents from "../../components/TableOfContents.astro";
import { filterHeadings } from "./headings.js";
interface Props {
  headings: readonly { depth: number; slug: string; text: string }[];
  depths?: readonly number[];
  label?: string;
  id?: string;
  presentation?: "list" | "compact";
  overviewLabel?: string;
  contentId?: string;
  scrollRootId?: string;
  class?: string;
}
const { headings, depths, label = "On this page", id = `moo-toc-${crypto.randomUUID()}`, ...options } = Astro.props;
const items = filterHeadings(headings, depths ? [...depths] : undefined).map(({ slug, text }) => ({ targetId: slug, label: text }));
---

<TableOfContents {...options} id={id} items={items} label={label} />
