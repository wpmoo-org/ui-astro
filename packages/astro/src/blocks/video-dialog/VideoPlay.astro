---
// Trigger of the Moo Core "Video Dialog" block: a round play button in a
// breathing ring, or with a visible label a compact pill for narrow screens.
// It opens the VideoDialog with the same id. The ring breathes only for
// visitors who allow motion (Core animate-breathe utility).
interface Props {
  dialogId: string;
  ariaLabel?: string;
  label?: string;
  /** A text-* utility for the play triangle, for example a brand colour. */
  iconClass?: string;
  class?: string;
}
const {
  dialogId,
  ariaLabel = "",
  label = "",
  iconClass = "text-primary",
  class: className = "",
} = Astro.props;
if (typeof dialogId !== "string" || !/^[A-Za-z][\w-]*$/u.test(dialogId)) {
  throw new TypeError("VideoPlay dialogId must be a plain element id");
}
for (const text of [ariaLabel, label]) {
  if (typeof text !== "string" || /[\x00-\x1f\x7f]/u.test(text)) {
    throw new TypeError("VideoPlay labels must be plain text");
  }
}
if (!label.trim() && !ariaLabel.trim()) {
  throw new TypeError("VideoPlay without a visible label requires ariaLabel");
}
const target = `#${dialogId}`;
// Lucide "play" (ISC), filled so the triangle reads at a glance.
const play = "M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z";
---

{
  label.trim() ? (
    <button
      type="button"
      class:list={[
        "btn rounded-pill d-inline-flex align-items-center gap-3 p-0 pe-4 border-0 bg-white bg-opacity-25 text-white fw-semibold",
        className,
      ]}
      data-bs-toggle="modal"
      data-bs-target={target}
      aria-label={ariaLabel.trim() || undefined}
    >
      <span class:list={["d-inline-flex rounded-circle bg-white p-3 shadow animate-breathe", iconClass]}>
        <svg viewBox="0 0 24 24" width="1.25em" height="1.25em" fill="currentColor" stroke="none" aria-hidden="true" focusable="false"><path d={play} /></svg>
      </span>
      {label.trim()}
    </button>
  ) : (
    <div class:list={["d-inline-flex rounded-circle p-3 bg-white bg-opacity-25 animate-breathe", className]}>
      <button
        type="button"
        class:list={["btn btn-light btn-lg rounded-circle p-4 shadow", iconClass]}
        data-bs-toggle="modal"
        data-bs-target={target}
        aria-label={ariaLabel.trim()}
      >
        <svg viewBox="0 0 24 24" width="2em" height="2em" fill="currentColor" stroke="none" aria-hidden="true" focusable="false"><path d={play} /></svg>
      </button>
    </div>
  )
}
