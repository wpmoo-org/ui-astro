---
// Astro side of the Moo Core "Image Gallery" block: photo thumbnails as a
// grid, justified rows, masonry columns, a featured layout or a sideways
// strip, and one
// lightbox Dialog with a Bootstrap Carousel. The markup mirrors Core's
// src/blocks/image_gallery.html.jinja; image-gallery.js is a byte copy of
// Core's public module until the pinned @wpmoo/ui ships it.
//
// Local images (ImageMetadata, including content-collection image()) are
// resized through astro:assets: thumbnails get a srcset for their layout,
// the lightbox a large srcset. A string src is used as given and needs its
// width and height. Every thumbnail links to its large image, so the
// gallery works without JavaScript; no large image is requested before the
// visitor opens one.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Button from "../../components/Button.astro";
import Dialog from "../../components/Dialog.astro";
import Progress from "../../components/Progress.astro";
import Icon from "../../components/internal/Icon.astro";
import "./image-gallery.css";

type Breakpoint = "xs" | "sm" | "md" | "lg" | "xl" | "xxl";

export interface GalleryImage {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  /** Lightbox title; defaults to alt. */
  caption?: string;
  /** Muted line under the lightbox title, such as place, year or author. */
  credit?: string;
}

export interface GalleryLabels {
  title: string;
  /** Accessible name of the strip's scroll region. */
  strip: string;
  close: string;
  previous: string;
  next: string;
  play: string;
  pause: string;
  progress: string;
  fullscreen: string;
  exitFullscreen: string;
  /** {current} and {total} are replaced. */
  counter: string;
  /** Name of a photo without alt text; {current} and {total} are replaced. */
  photo: string;
  /** {total} is replaced. */
  showAll: string;
}

interface Props {
  id: string;
  images: GalleryImage[];
  layout?: "grid" | "justified" | "masonry" | "featured" | "strip";
  ratio?: "1x1" | "4x3" | "3x2";
  columns?: Partial<Record<Breakpoint, 1 | 2 | 3 | 4>>;
  gap?: 0 | 1 | 2 | 3 | 4 | 5;
  limit?: number | "all";
  /** Strip only below this breakpoint, justified rows from it up. */
  stripUntil?: "" | "sm" | "md" | "lg" | "xl" | "xxl";
  /** Run the strip to the screen edges through the content gutter. */
  stripBleed?: boolean;
  /** How the lightbox changes photos. */
  transition?: "fade" | "slide";
  /** Thumbnail sizes attribute, for example "(min-width: 992px) 20vw, 50vw"
   *  when the gallery sits in a narrower column than the viewport. */
  sizes?: string;
  labels?: Partial<GalleryLabels>;
  class?: string;
}

const DEFAULT_LABELS: GalleryLabels = {
  title: "Photos",
  strip: "Photos, scroll sideways",
  close: "Close",
  previous: "Previous",
  next: "Next",
  play: "Play slideshow",
  pause: "Pause slideshow",
  progress: "Time until the next photo",
  fullscreen: "Full screen",
  exitFullscreen: "Exit full screen",
  counter: "{current} of {total}",
  photo: "Photo {current} of {total}",
  showAll: "Show all {total} photos",
};
const BREAKPOINTS: Breakpoint[] = ["xs", "sm", "md", "lg", "xl", "xxl"];
const BREAKPOINT_WIDTHS: Record<Breakpoint, number> = {
  xs: 0,
  sm: 576,
  md: 768,
  lg: 992,
  xl: 1200,
  xxl: 1400,
};

const {
  id,
  images,
  layout = "grid",
  ratio = "4x3",
  columns = { xs: 2, md: 3 },
  gap = 2,
  limit = 9,
  stripUntil = "",
  stripBleed = false,
  transition = "fade",
  sizes = "",
  labels = {},
  class: className = "",
} = Astro.props;

if (typeof id !== "string" || !/^[A-Za-z][\w-]*$/u.test(id)) {
  throw new TypeError("ImageGallery id must be a plain element id");
}
if (!Array.isArray(images) || images.length === 0) {
  throw new TypeError("ImageGallery requires at least one image");
}
if (!["grid", "justified", "masonry", "featured", "strip"].includes(layout)) {
  throw new TypeError(`Unknown ImageGallery layout: ${layout}`);
}
if (!["1x1", "4x3", "3x2"].includes(ratio)) {
  throw new TypeError(`Unknown ImageGallery ratio: ${ratio}`);
}
if (!["", "sm", "md", "lg", "xl", "xxl"].includes(stripUntil)) {
  throw new TypeError(`Unknown ImageGallery stripUntil breakpoint: ${stripUntil}`);
}
if (!["fade", "slide"].includes(transition)) {
  throw new TypeError("ImageGallery transition must be fade or slide");
}
if (typeof sizes !== "string" || /[\x00-\x1f\x7f]/u.test(sizes)) {
  throw new TypeError("ImageGallery sizes must be plain text");
}
if (![0, 1, 2, 3, 4, 5].includes(gap)) {
  throw new TypeError("ImageGallery gap must be a spacer from 0 to 5");
}
if (limit !== "all" && !(Number.isInteger(limit) && limit >= 1)) {
  throw new TypeError('ImageGallery limit must be a positive integer or "all"');
}
for (const [breakpoint, count] of Object.entries(columns)) {
  if (!BREAKPOINTS.includes(breakpoint as Breakpoint)) {
    throw new TypeError(`Unknown ImageGallery breakpoint: ${breakpoint}`);
  }
  if (![1, 2, 3, 4].includes(count as number)) {
    throw new TypeError("ImageGallery columns must be 1 to 4");
  }
}
const text: GalleryLabels = { ...DEFAULT_LABELS, ...labels };
for (const [name, value] of Object.entries(text)) {
  if (typeof value !== "string" || !value.trim() || /[\x00-\x1f\x7f]/u.test(value)) {
    throw new TypeError(`ImageGallery label ${name} must be plain text`);
  }
}

const total = images.length;
// A strip scrolls through every photo, so limit does not apply to it.
const shown = limit === "all" || layout === "strip" ? total : Math.min(limit, total);
const lightboxId = `${id}-lightbox`;
const infix = (breakpoint: Breakpoint) => (breakpoint === "xs" ? "" : `${breakpoint}-`);
const ordered = BREAKPOINTS.filter((breakpoint) => columns[breakpoint]);
const gridColumns = ordered.map((b) => `row-cols-${infix(b)}${columns[b]}`).join(" ");
const masonryColumns = ordered.map((b) => `columns-${infix(b)}${columns[b]}`).join(" ");
// Thumbnails take one column of the viewport at each breakpoint.
const columnSizes = [...ordered]
  .reverse()
  .map((b) => {
    const width = `${Math.ceil(100 / (columns[b] as number))}vw`;
    return b === "xs" ? width : `(min-width: ${BREAKPOINT_WIDTHS[b]}px) ${width}`;
  })
  .join(", ");

const THUMB_WIDTHS = [320, 480, 640, 960];
const FEATURED_WIDTHS = [640, 960, 1280, 1600];
const LARGE_WIDTHS = [960, 1280, 1920, 2560];
const within = (list: number[], width: number) => {
  const fitting = list.filter((candidate) => candidate < width);
  return [...fitting, Math.min(width, list[list.length - 1])];
};

const prepared = await Promise.all(
  images.map(async (image, index) => {
    if (!image || typeof image.alt !== "string" || /[\x00-\x1f\x7f]/u.test(image.alt)) {
      throw new TypeError("ImageGallery images need plain alt text");
    }
    for (const field of ["caption", "credit"] as const) {
      const value = image[field];
      if (value !== undefined && (typeof value !== "string" || /[\x00-\x1f\x7f]/u.test(value))) {
        throw new TypeError(`ImageGallery image ${field} must be plain text`);
      }
    }
    const featuredFirst = layout === "featured" && index === 0;
    if (typeof image.src === "string") {
      const { width, height } = image;
      if (!image.src.trim() || !(Number(width) > 0) || !(Number(height) > 0)) {
        throw new TypeError("ImageGallery string sources need src, width and height");
      }
      return { image, width: Number(width), height: Number(height), src: image.src, href: image.src };
    }
    const { width, height } = image.src;
    const widths = within(featuredFirst ? FEATURED_WIDTHS : THUMB_WIDTHS, width);
    const thumb = await getImage({
      src: image.src,
      width: widths[Math.min(2, widths.length - 1)],
      widths,
    });
    const largeWidths = within(LARGE_WIDTHS, width);
    const large = await getImage({
      src: image.src,
      width: Math.min(width, 1920),
      widths: largeWidths,
    });
    return {
      image,
      width,
      height,
      src: thumb.src,
      srcset: thumb.srcSet.attribute || undefined,
      href: large.src,
      largeSrcset: large.srcSet.attribute || undefined,
    };
  }),
);

const ratioOf = (entry: { width: number; height: number }) =>
  Math.round((entry.width / entry.height) * 10000) / 10000;
const thumbSizes = (entry: { width: number; height: number }, index: number) => {
  if (sizes) return sizes;
  if (layout === "featured" && index === 0) return "100vw";
  // A justified or strip photo is about as wide as its ratio at 16rem.
  if (layout === "justified" || layout === "strip") return `${Math.ceil(ratioOf(entry) * 256)}px`;
  return columnSizes || "100vw";
};
const counter = (current: number) =>
  text.counter.replaceAll("{current}", String(current)).replaceAll("{total}", String(total));
const first = prepared[0];
const rest = layout === "featured" ? prepared.slice(1) : prepared;
const restOffset = layout === "featured" ? 1 : 0;
const stripClasses = [
  stripUntil ? `gallery-justified gallery-strip-${stripUntil}-down` : "gallery-strip",
  stripBleed && "gallery-strip-bleed",
  "scroll-smooth",
  `gap-${gap}`,
]
  .filter(Boolean)
  .join(" ");
// A photo with empty alt text is named by its place in the album.
const photoName = (index: number) =>
  text.photo.replaceAll("{current}", String(index + 1)).replaceAll("{total}", String(total));
const linkData = (index: number) => ({
  "aria-label": prepared[index].image.alt.trim() ? undefined : photoName(index),
  href: prepared[index].href,
  "data-bs-toggle": "modal",
  "data-bs-target": `#${lightboxId}`,
  "data-gallery-index": String(index),
});
---

<div class:list={[className]} id={id} data-image-gallery>
  {
    layout === "justified" ? (
      <div class={`gallery-justified gap-${gap}`}>
        {prepared.map((entry, index) => (
          <a
            class:list={["d-block rounded overflow-hidden", index >= shown && "d-none"]}
            {...linkData(index)}
            style={`--moo-gallery-ratio: ${ratioOf(entry)}`}
          >
            <img class="d-block w-100 h-auto" src={entry.src} srcset={entry.srcset} sizes={entry.srcset ? thumbSizes(entry, index) : undefined} width={entry.width} height={entry.height} alt={entry.image.alt} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    ) : layout === "strip" ? (
      <div class={stripClasses} role="region" tabindex="0" aria-label={text.strip}>
        {prepared.map((entry, index) => (
          <a class="d-block rounded overflow-hidden" {...linkData(index)} style={`--moo-gallery-ratio: ${ratioOf(entry)}`}>
            <img class="d-block w-100 h-100 object-fit-cover" src={entry.src} srcset={entry.srcset} sizes={entry.srcset ? thumbSizes(entry, index) : undefined} width={entry.width} height={entry.height} alt={entry.image.alt} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    ) : layout === "masonry" ? (
      <div class={`${masonryColumns} column-gap-${gap}`}>
        {prepared.map((entry, index) => (
          <a class:list={[`d-inline-block w-100 mb-${gap} rounded overflow-hidden`, index >= shown && "d-none"]} {...linkData(index)}>
            <img class="d-block w-100 h-auto" src={entry.src} srcset={entry.srcset} sizes={entry.srcset ? thumbSizes(entry, index) : undefined} width={entry.width} height={entry.height} alt={entry.image.alt} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    ) : (
      <>
        {layout === "featured" ? (
          <div class={`mb-${gap}`}>
            <a class="ratio ratio-16x9 d-block rounded overflow-hidden" {...linkData(0)}>
              <img class="object-fit-cover" src={first.src} srcset={first.srcset} sizes={first.srcset ? thumbSizes(first, 0) : undefined} width={first.width} height={first.height} alt={first.image.alt} loading="lazy" decoding="async" />
            </a>
          </div>
        ) : null}
        {rest.length ? (
          <div class={["row", gridColumns, `g-${gap}`].filter(Boolean).join(" ")}>
            {rest.map((entry, position) => {
              const index = position + restOffset;
              return (
                <div class:list={["col", index >= shown && "d-none"]}>
                  <a class={`ratio ratio-${ratio} d-block rounded overflow-hidden`} {...linkData(index)}>
                    <img class="object-fit-cover" src={entry.src} srcset={entry.srcset} sizes={entry.srcset ? thumbSizes(entry, index) : undefined} width={entry.width} height={entry.height} alt={entry.image.alt} loading="lazy" decoding="async" />
                  </a>
                </div>
              );
            })}
          </div>
        ) : null}
      </>
    )
  }

  {
    shown < total ? (
      <div class="mt-3">
        <Button label={text.showAll.replaceAll("{total}", String(total))} variant="outline" dialogTarget={lightboxId} />
      </div>
    ) : null
  }

  <Dialog id={lightboxId} size="xl" fullscreenDown="lg" centered ariaLabel={text.title}>
    <Fragment slot="content">
      <div class="d-flex align-items-center justify-content-between gap-3 border-bottom ps-3 ps-sm-4 pe-2 py-2">
        <p class="m-0 small text-body-secondary" aria-live="polite" data-gallery-counter={text.counter}>{counter(1)}</p>
        <div class="d-flex align-items-center gap-1">
          <Button variant="ghost" size="icon-sm" ariaLabel={text.fullscreen} id={`${lightboxId}-fullscreen`}>
            <Icon slot="icon-start" name="maximize-2" />
          </Button>
          <Button variant="ghost" size="icon-sm" ariaLabel={text.exitFullscreen} id={`${lightboxId}-windowed`} class="d-none">
            <Icon slot="icon-start" name="minimize-2" />
          </Button>
          <Button variant="ghost" size="icon-sm" ariaLabel={text.close} dismiss="modal">
            <Icon slot="icon-start" name="x" />
          </Button>
        </div>
      </div>
      <div class="modal-body d-flex p-0 bg-body-tertiary">
        <div class:list={["carousel slide", transition === "fade" && "carousel-fade", "flex-grow-1 gallery-stage"]} id={`${lightboxId}-carousel`} data-bs-interval="false" data-bs-touch="true" data-gallery-stage>
          <div class="carousel-inner h-100">
            {prepared.map((entry, index) => (
              <div
                class:list={["carousel-item h-100", index === 0 && "active"]}
                data-gallery-slide-title={entry.image.caption || entry.image.alt || photoName(index)}
                data-gallery-slide-credit={entry.image.credit || undefined}
              >
                <div class="h-100 d-flex align-items-center justify-content-center p-3 p-sm-4 bg-body-tertiary">
                  <img class="mw-100 mh-100 w-auto h-auto rounded-2 border shadow-sm" data-gallery-src={entry.href} data-gallery-srcset={entry.largeSrcset} sizes={entry.largeSrcset ? "(min-width: 1200px) 1140px, 100vw" : undefined} width={entry.width} height={entry.height} alt={entry.image.alt} decoding="async" />
                </div>
              </div>
            ))}
          </div>
        </div>
        {
          total > 1 ? (
            <Progress value={0} ariaLabel={text.progress} class="gallery-progress position-absolute bottom-0 start-0 z-2 w-100 rounded-0 bg-transparent d-none" />
          ) : null
        }
      </div>
      <div class="d-flex flex-wrap align-items-center gap-3 border-top px-3 px-sm-4 py-3">
        <div class="me-auto">
          <p class="m-0 fw-medium" data-gallery-caption>{first.image.caption || first.image.alt || photoName(0)}</p>
          <p class:list={["m-0 small text-body-secondary", !first.image.credit && "d-none"]} data-gallery-credit>{first.image.credit || ""}</p>
        </div>
        {
          total > 1 ? (
            <div class="d-flex align-items-center gap-2">
              <Button label={text.previous} variant="outline" id={`${lightboxId}-previous`}>
                <Icon slot="icon-start" name="chevron-left" />
              </Button>
              <Button variant="outline" size="icon" ariaLabel={text.play} id={`${lightboxId}-play`}>
                <Icon slot="icon-start" name="play" />
              </Button>
              <Button variant="outline" size="icon" ariaLabel={text.pause} id={`${lightboxId}-pause`} class="d-none">
                <Icon slot="icon-start" name="pause" />
              </Button>
              <Button label={text.next} variant="outline" id={`${lightboxId}-next`}>
                <Icon slot="icon-end" name="chevron-right" position="inline-end" />
              </Button>
            </div>
          ) : null
        }
      </div>
    </Fragment>
  </Dialog>
</div>

<script>
  import { initImageGalleries } from "./image-gallery.js";
  initImageGalleries();
</script>
