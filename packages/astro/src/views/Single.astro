---
import PageHeader from "../includes/PageHeader.astro";
import {
  getEntryClasses,
  type EntryClassContext,
  type PartsInput,
} from "../config/index.js";

interface Props {
  title: string;
  description?: string;
  entryContext?: EntryClassContext;
  parts?: PartsInput;
  forwardedSlots?: {
    pageHeader: boolean;
    metadata: boolean;
    actions: boolean;
    afterContent: boolean;
  };
}

const { title, description, entryContext, parts, forwardedSlots } = Astro.props;
if (!Astro.slots.has("default"))
  throw new TypeError("Single requires its content slot");
const entryClasses = entryContext ? getEntryClasses(entryContext) : [];
const hasPageHeader =
  forwardedSlots?.pageHeader ?? Astro.slots.has("page-header");
const hasMetadata = forwardedSlots?.metadata ?? Astro.slots.has("metadata");
const hasActions = forwardedSlots?.actions ?? Astro.slots.has("actions");
const hasAfterContent =
  forwardedSlots?.afterContent ?? Astro.slots.has("after-content");
---

<div class="row gx-0" data-layout="page-grid">
  <article
    class:list={[entryClasses, "col-12", "lh-lg"]}
    data-page-col-md="9"
    data-page-col-xl="8"
  >
    {
      hasPageHeader ? (
        <slot name="page-header" />
      ) : (
        <PageHeader title={title} description={description} parts={parts}>
          {hasMetadata ? <slot name="metadata" slot="metadata" /> : null}
          {hasActions ? <slot name="actions" slot="actions" /> : null}
        </PageHeader>
      )
    }
    <div class="text-body-secondary">
      <slot />
    </div>
    {hasAfterContent ? <slot name="after-content" /> : null}
  </article>
</div>
