---
import Typography from "../components/Typography.astro";
import Empty from "../components/Empty.astro";
import { Image } from "astro:assets";
import { imageSchema, type ContentImage } from "../content/index.js";
import {
  defineSite,
  formatDate,
  getEntryClasses,
  resolveParts,
  type DateFormatter,
  type EntryClassContext,
  type PartsInput,
} from "../config/index.js";
import { navigationHref } from "../internal/href.js";

interface LoopItem {
  id: string;
  title: string;
  href: string;
  description?: string;
  cover?: ContentImage;
  date?: Date;
  entryContext?: EntryClassContext;
}
interface Props {
  items: LoopItem[];
  emptyText?: string;
  titleVariant?: "section-title" | "subsection-title";
  parts?: PartsInput;
  lang?: string;
  dateFormatter?: DateFormatter;
}

const parts = resolveParts(Astro.props.parts);
const {
  items,
  emptyText = parts.loop.emptyText,
  titleVariant = parts.loop.titleVariant,
  lang = defineSite().defaults.lang,
  dateFormatter,
} = Astro.props;
if (!Array.isArray(items)) throw new TypeError("Loop items must be an array");
if (titleVariant !== "section-title" && titleVariant !== "subsection-title") {
  throw new TypeError(
    "Loop titleVariant must be section-title or subsection-title",
  );
}
if (typeof emptyText !== "string")
  throw new TypeError("Loop emptyText must be text");
const checkedItems = items.map((item, index) => {
  if (
    !item ||
    typeof item.id !== "string" ||
    !item.id ||
    typeof item.title !== "string" ||
    !item.title.trim()
  ) {
    throw new TypeError(`Loop items[${index}] needs an id and title`);
  }
  navigationHref(item.href, `Loop items[${index}].href`);
  if (item.description !== undefined && typeof item.description !== "string") {
    throw new TypeError(`Loop items[${index}].description must be text`);
  }
  if (
    item.date !== undefined &&
    (!(item.date instanceof Date) || !Number.isFinite(item.date.getTime()))
  ) {
    throw new TypeError(`Loop items[${index}].date must be a valid Date`);
  }
  return {
    ...item,
    cover: item.cover === undefined ? undefined : imageSchema.parse(item.cover),
    entryClasses: item.entryContext ? getEntryClasses(item.entryContext) : [],
    dateText: item.date
      ? formatDate(item.date, {
          lang,
          style: parts.loop.dateStyle,
          formatter: dateFormatter,
        })
      : undefined,
  };
});
---

{
  checkedItems.length ? (
    <ul class:list={parts.loop.utilities}>
      {checkedItems.map((item) => (
        <li class:list={[item.entryClasses, parts.loop.itemUtilities]}>
          <div class="row g-4 align-items-center" data-layout="page-grid">
            {item.cover ? (
              <div class="col-12" data-page-col-lg="5">
                <a href={item.href} tabindex="-1" aria-hidden="true">
                  <Image
                    {...item.cover}
                    src={item.cover.src.startsWith("/")
                      ? `${import.meta.env.BASE_URL.replace(/\/$/u, "")}${item.cover.src}`
                      : item.cover.src}
                    alt=""
                    class="img-fluid rounded"
                    loading="lazy"
                  />
                </a>
              </div>
            ) : null}
            <div
              class="col-12 d-flex flex-column gap-3"
              data-page-col-lg={item.cover ? "7" : undefined}
            >
              {item.date ? (
                <time class="small text-body-secondary" datetime={item.date.toISOString()}>
                  {item.dateText}
                </time>
              ) : null}
              <Typography
                variant={titleVariant}
                content={item.title}
                class={parts.loop.titleUtilities.join(" ")}
              >
                <a
                  class="text-reset link-underline link-underline-opacity-0 link-underline-opacity-100-hover"
                  href={item.href}
                >
                  {item.title}
                </a>
              </Typography>
              {item.description ? (
                <p class:list={parts.loop.descriptionUtilities}>
                  {item.description}
                </p>
              ) : null}
            </div>
          </div>
        </li>
      ))}
    </ul>
  ) : emptyText.trim() ? (
    <Empty title={emptyText} class={parts.loop.emptyUtilities.join(" ")} />
  ) : null
}
