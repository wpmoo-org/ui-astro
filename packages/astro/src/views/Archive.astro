---
import ContentFrame from "../layouts/ContentFrame.astro";
import { selectAsidePlacements } from "../placements/aside.js";
import Placement from "../placements/Placement.astro";
import type { PlacementPlan } from "../placements/index.js";
import type { ContentAsideInput } from "../config/index.js";
import PageHeader from "../includes/PageHeader.astro";
import Loop from "./Loop.astro";
import type {
  DateFormatter,
  EntryClassContext,
  PartsInput,
} from "../config/index.js";

interface LoopItem {
  id: string;
  title: string;
  href: string;
  description?: string;
  date?: Date;
  entryContext?: EntryClassContext;
}
interface Props {
  plan?: PlacementPlan<unknown>;
  compactToc?: boolean;
  aside?: ContentAsideInput | null;
  asideLabel?: string;
  dir?: "ltr" | "rtl";
  title: string;
  description?: string;
  items?: LoopItem[];
  emptyText?: string;
  titleVariant?: "section-title" | "subsection-title";
  parts?: PartsInput;
  lang?: string;
  dateFormatter?: DateFormatter;
  forwardedSlots?: {
    aside?: boolean;
    before?: boolean;
    taxonomies?: boolean;
    pageHeader: boolean;
    actions: boolean;
    loop: boolean;
    afterList: boolean;
  };
}

const {
  title,
  description,
  items = [],
  emptyText,
  titleVariant,
  parts,
  lang,
  dateFormatter,
  forwardedSlots,
  plan, aside, asideLabel, dir,
} = Astro.props;
const hasPageHeader =
  forwardedSlots?.pageHeader ?? Astro.slots.has("page-header");
const hasActions = forwardedSlots?.actions ?? Astro.slots.has("actions");
const hasLoop = forwardedSlots?.loop ?? Astro.slots.has("loop");
const hasAfterList = forwardedSlots?.afterList ?? Astro.slots.has("after-list");
const hasAside = forwardedSlots?.aside ?? Astro.slots.has("aside");
const selectedAside = selectAsidePlacements(plan, aside, hasAside, Astro.props.compactToc ?? false);
const hasBefore = forwardedSlots?.before ?? Astro.slots.has("before-list");
---

<ContentFrame contentId={plan?.contentId} asideMobileBody={!Astro.props.compactToc || selectedAside.hasMobileBody || hasAside} element="section" class={""} aside={aside} asideLabel={asideLabel ?? plan?.labels.aside} dir={dir}>
  <Fragment slot="aside">{hasAside ? <slot name="aside" /> : plan ? <Placement plan={plan} at="aside.content" placements={selectedAside.placements} tocContentId={plan.contentId} tocScrollRootId="main-content" tocClass={selectedAside.listClass} /> : null}</Fragment>
    {
      hasPageHeader ? (
        <slot name="page-header" />
      ) : (
        <PageHeader title={title} description={description} parts={parts}>
          {hasActions ? <slot name="actions" slot="actions" /> : null}
        </PageHeader>
      )
    }
    {hasBefore ? <slot name="before-list" /> : plan ? <Placement plan={plan} at="archive.before-list" /> : null}
    {
      hasLoop ? (
        <slot name="loop" />
      ) : (
        <Loop
          items={items}
          emptyText={emptyText}
          titleVariant={titleVariant}
          parts={parts}
          lang={lang}
          dateFormatter={dateFormatter}
        />
      )
    }
    {hasAfterList ? <slot name="after-list" /> : plan ? <Placement plan={plan} at="archive.after-list" /> : null}

</ContentFrame>
