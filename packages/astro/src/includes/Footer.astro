---
import { navigationHref } from "../internal/href.js";
import { defineSite, resolveParts, type PartsInput } from "../config/index.js";

interface Props {
  homeHref: string;
  brand?: string;
  parts?: PartsInput;
}

const parts = resolveParts(Astro.props.parts);
const { homeHref, brand = defineSite().brand } = Astro.props;
navigationHref(homeHref, "Footer homeHref");
if (typeof brand !== "string" || !brand.trim())
  throw new TypeError("Footer brand must be nonempty text");
---

<slot
  ><a class:list={parts.footer.linkUtilities} href={homeHref}>{brand}</a></slot
>
