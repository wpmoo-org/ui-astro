---
import type { ContentAsideInput } from "../../../config/index.js";
import type { PlacementPlan } from "../../../placements/index.js";
import type { CollectionEntry } from "astro:content";
import {
  defineSite,
  resolveParts,
  type DateFormatter,
  type PartsInput,
} from "../../../config/index.js";
import Archive from "../../../views/Archive.astro";
import Loop from "./Loop.astro";

interface Props {
  plan?: PlacementPlan<unknown>;
  compactToc?: boolean;
  aside?: ContentAsideInput | null;
  asideLabel?: string;
  dir?: "ltr" | "rtl";
  parts?: PartsInput;
  dateFormatter?: DateFormatter;
  entries: CollectionEntry<"post">[];
  title?: string;
  description?: string;
  basePath?: string;
  base?: string;
  trailingSlash?: "always" | "never" | "ignore";
  lang?: string;
  locale?: string;
  dateLang?: string;
  emptyText?: string;
  titleVariant?: "section-title" | "subsection-title";
}

const parts = resolveParts(Astro.props.parts);
const {
  entries,
  title = parts.loop.postTitle,
  description,
  basePath = "/posts",
  base = "/",
  trailingSlash = "ignore",
  lang = defineSite().defaults.lang,
  locale,
  dateLang = lang,
  emptyText = parts.loop.postEmptyText,
  titleVariant,
  dateFormatter,
} = Astro.props;
---

<Archive
  plan={Astro.props.plan}
  compactToc={Astro.props.compactToc}
  aside={Astro.props.aside}
  asideLabel={Astro.props.asideLabel}
  dir={Astro.props.dir}
  parts={parts}
  lang={dateLang}
  dateFormatter={dateFormatter}
  title={title}
  description={description}
  emptyText={emptyText}
  titleVariant={titleVariant}
  forwardedSlots={{
    aside: Astro.slots.has("aside"),
    before: Astro.slots.has("before-list"),
    taxonomies: Astro.slots.has("taxonomies"),
    pageHeader: Astro.slots.has("page-header"),
    actions: Astro.slots.has("actions"),
    loop: true,
    afterList: Astro.slots.has("after-list"),
  }}
>
  {
    Astro.slots.has("page-header") ? (
      <slot name="page-header" slot="page-header" />
    ) : null
  }
  {Astro.slots.has("actions") ? <slot name="actions" slot="actions" /> : null}
  {
    Astro.slots.has("loop") ? (
      <slot name="loop" slot="loop" />
    ) : (
      <Loop
        parts={parts}
        dateFormatter={dateFormatter}
        slot="loop"
        entries={entries}
        basePath={basePath}
        base={base}
        trailingSlash={trailingSlash}
        lang={lang}
        locale={locale}
        dateLang={dateLang}
        emptyText={emptyText}
        titleVariant={titleVariant}
      />
    )
  }
  {
    Astro.slots.has("after-list") ? (
      <slot name="after-list" slot="after-list" />
    ) : null
  }
  {Astro.slots.has("aside") ? <slot name="aside" slot="aside" /> : null}
  {Astro.slots.has("before-list") ? <slot name="before-list" slot="before-list" /> : null}
  {Astro.slots.has("taxonomies") ? <slot name="taxonomies" slot="taxonomies" /> : null}
</Archive>
