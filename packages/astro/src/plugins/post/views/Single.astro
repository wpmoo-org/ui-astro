---
import type { ContentAsideInput } from "../../../config/index.js";
import type { PlacementPlan } from "../../../placements/index.js";
import Single from "../../../views/Single.astro";
import type { CollectionEntry } from "astro:content";
import {
  defineSite,
  formatDate,
  resolveParts,
  type DateFormatter,
  type PartsInput,
} from "../../../config/index.js";
import { entryClassContext } from "../../../taxonomies/paths.js";

interface Props {
  plan?: PlacementPlan<unknown>;
  compactToc?: boolean;
  aside?: ContentAsideInput | null;
  asideLabel?: string;
  dir?: "ltr" | "rtl";
  entry: CollectionEntry<"post">;
  parts?: PartsInput;
  lang?: string;
  dateFormatter?: DateFormatter;
}
const parts = resolveParts(Astro.props.parts);
const { entry, lang = defineSite().defaults.lang, dateFormatter } = Astro.props;
if (entry?.collection !== "post")
  throw new TypeError("Post Single entry must belong to collection post");
const date = entry.data.published_at;
if (
  date !== undefined &&
  (!(date instanceof Date) || !Number.isFinite(date.getTime()))
) {
  throw new TypeError("Post Single published_at must be a valid Date");
}
const hasMetadata = Astro.slots.has("metadata");
const dateText =
  !hasMetadata && date
    ? formatDate(date, {
        lang,
        style: parts.loop.dateStyle,
        formatter: dateFormatter,
      })
    : undefined;
---

<Single
  plan={Astro.props.plan}
  compactToc={Astro.props.compactToc}
  aside={Astro.props.aside}
  asideLabel={Astro.props.asideLabel}
  dir={Astro.props.dir}
  parts={parts}
  title={entry.data.title}
  description={entry.data.description}
  entryContext={entryClassContext(
    { id: "post", sourceKind: "markdown" },
    entry,
  )}
  forwardedSlots={{
    aside: Astro.slots.has("aside"),
    before: Astro.slots.has("before-content"),
    taxonomies: Astro.slots.has("taxonomies"),
    pageHeader: Astro.slots.has("page-header"),
    metadata: hasMetadata || date !== undefined,
    actions: Astro.slots.has("actions"),
    afterContent: Astro.slots.has("after-content"),
  }}
>
  {
    Astro.slots.has("page-header") ? (
      <slot name="page-header" slot="page-header" />
    ) : null
  }
  {
    hasMetadata ? (
      <slot name="metadata" slot="metadata" />
    ) : date ? (
      <time
        slot="metadata"
        class="small text-body-secondary"
        datetime={date.toISOString()}
      >
        {dateText}
      </time>
    ) : null
  }
  {Astro.slots.has("actions") ? <slot name="actions" slot="actions" /> : null}
  <slot />
  {
    Astro.slots.has("after-content") ? (
      <slot name="after-content" slot="after-content" />
    ) : null
  }
  {Astro.slots.has("aside") ? <slot name="aside" slot="aside" /> : null}
  {Astro.slots.has("before-content") ? <slot name="before-content" slot="before-content" /> : null}
  {Astro.slots.has("taxonomies") ? <slot name="taxonomies" slot="taxonomies" /> : null}
</Single>
