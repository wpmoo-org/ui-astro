---
// The HTML sitemap of one locale (sitemap.routeOwner "plugin"). Its body is
// SitemapContent, which host-owned pages place too: at build it renders one
// template group whose one row holds sentinel tokens; the integration fills
// it at astro:build:done from the same scan that writes sitemap.xml.
import { getSitemapOptions } from "../../sitemap/index.js";
import { resolveSeoMetadata } from "../../seo/index.js";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ContentFrame from "../../layouts/ContentFrame.astro";
import PageHeader from "../../includes/PageHeader.astro";
import SitemapContent from "../../blocks/sitemap-content/SitemapContent.astro";

export const prerender = true;
const data = getSitemapOptions(Astro.currentLocale);
const { copy } = data;
const metadata = Astro.site
  ? resolveSeoMetadata(data.site, {
      title: copy.title,
      status: "publish",
      view: "native",
      lang: data.options.lang,
      url: new URL(data.href, Astro.site).href,
      alternates:
        data.languageLinks.length > 1
          ? data.languageLinks.map((link) => ({
              locale: link.locale,
              url: new URL(link.href, Astro.site).href,
            }))
          : undefined,
    })
  : undefined;
---

<SiteLayout
  title={copy.title}
  options={data.options}
  href={data.href}
  locale={data.locale}
  metadata={metadata}
  languageLinks={data.languageLinks}
>
  <ContentFrame element="article" dir={data.options.dir}>
    <PageHeader title={copy.title} parts={data.options.parts} />
    <SitemapContent locale={data.locale} />
  </ContentFrame>
</SiteLayout>
