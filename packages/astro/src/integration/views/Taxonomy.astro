---
import Layout from "../../layouts/Layout.astro";
import Header from "../../includes/Header.astro";
import Footer from "../../includes/Footer.astro";
import Sidebar from "../../includes/Sidebar.astro";
import Archive from "../../views/Archive.astro";
import { resolvePageOptions } from "../../config/index.js";
import { resolveSeoMetadata } from "../../seo/index.js";
import { getSiteContext, getSiteNavigation } from "../../context/index.js";
import { type TaxonomyPath } from "../../taxonomies/queries.js";

type Props = TaxonomyPath["props"];
const { taxonomy, term, href, breadcrumbs, items, locale, alternates } =
  Astro.props;
const { site } = getSiteContext();
const options = resolvePageOptions(
  site,
  taxonomy,
  "archive",
  undefined,
  locale,
);
const navigation = await getSiteNavigation(href, locale);
const homeHref = breadcrumbs.find((item) => item.href)?.href ?? href;
const layoutProps = {
  title: term.name,
  description: term.description,
  metadata: Astro.site
    ? resolveSeoMetadata(site, {
        title: term.name,
        description: term.description,
        status: "publish",
        type: taxonomy,
        view: "archive",
        lang: options.lang,
        url: new URL(href, Astro.site).href,
        alternates: alternates?.map((link) => ({
          locale: link.locale,
          url: new URL(link.href, Astro.site).href,
        })),
      })
    : undefined,
  pageContext: { view: "taxonomy" as const, taxonomy, term: term.id },
  shellMode: options.shellMode,
  pageWidth: options.pageWidth,
  headerWidth: options.headerWidth,
  theme: options.theme,
  lang: options.lang,
  dir: options.dir,
  parts: options.parts,
};
---

{
  options.sidebar ? (
    <Layout
      {...layoutProps}
      sidebar
      sidebarId="moo-site-sidebar"
      sidebarKey="moo-site"
      defaultOpen={options.sidebar.defaultOpen}
    >
      <Sidebar
        slot="sidebar"
        id="moo-site-sidebar"
        brand={site.brand}
        brandHref={homeHref}
        groups={[
          {
            items: navigation.map((item) => ({
              title: item.label,
              href: item.href,
              active: item.active,
            })),
          },
        ]}
        side={options.sidebar.side}
        variant={options.sidebar.variant}
        collapsible={options.sidebar.collapsible}
        rail={options.sidebar.rail}
        parts={options.parts}
      />
      <Header slot="header" parts={options.parts} breadcrumbs={breadcrumbs} />
      <Archive
        title={term.name}
        description={term.description}
        items={[...items]}
        parts={options.parts}
        lang={options.lang}
      />
      <Footer
        slot="footer"
        parts={options.parts}
        brand={site.brand}
        homeHref={homeHref}
      />
    </Layout>
  ) : (
    <Layout {...layoutProps}>
      <Header slot="header" parts={options.parts} breadcrumbs={breadcrumbs} />
      <Archive
        title={term.name}
        description={term.description}
        items={[...items]}
        parts={options.parts}
        lang={options.lang}
      />
      <Footer
        slot="footer"
        parts={options.parts}
        brand={site.brand}
        homeHref={homeHref}
      />
    </Layout>
  )
}
