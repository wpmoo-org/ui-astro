{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "apps/demo/.astro/types.d.ts",
    "packages/astro/src/**/*",
    "packages/theme-pilot/src/**/*",
    "apps/demo/**/*",
    "tests/public-api.ts",
    "tests/theme-types.ts",
    "tests/integration-types.ts",
    "tests/plugin-types.ts"
  ],
  "exclude": ["**/dist", "tests/fixtures", "apps/consumer"]
}
