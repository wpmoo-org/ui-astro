{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "demo/**/*",
    "tests/public-api.ts",
    "tests/theme-types.ts",
    "tests/integration-types.ts"
  ],
  "exclude": ["dist", "tests/fixtures"]
}
